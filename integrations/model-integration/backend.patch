+func TestDrawingCapabilityEvidenceScopesIdentityProxyAndOperation(t *testing.T) {
+	t.Setenv("SUB2API_DRAWING_CAPABILITY_DIR", t.TempDir())
+	proxy := int64(850)
+	a := &Account{ID: 1421, Platform: PlatformOpenAI, Type: AccountTypeOAuth, ProxyID: &proxy, Credentials: map[string]any{"chatgpt_account_id": "identity-a", "access_token": "secret-a"}}
+	model := "gpt-image-2.5-flare"
+	if DrawingAccountModelCanServe(a, model, "generate") {
+		t.Fatal("untested model scheduled")
+	}
+	result := &OpenAIForwardResult{UpstreamResponseModel: model, UpstreamEndpoint: "/backend-api/codex/images/generations"}
+	if e := RecordDrawingModelEvidence(a, model, "generate", "isolated-job", true, result, nil); e != nil {
+		t.Fatal(e)
+	}
+	if !DrawingAccountModelCanServe(a, model, "generate") || DrawingAccountModelCanServe(a, model, "edit") {
+		t.Fatal("operation evidence leaked")
+	}
+	a.Credentials["access_token"] = "secret-b"
+	if !DrawingAccountModelCanServe(a, model, "generate") {
+		t.Fatal("normal token renewal discarded capability")
+	}
+	proxy = 851
+	if DrawingAccountModelCanServe(a, model, "generate") {
+		t.Fatal("proxy change kept old evidence")
+	}
+	proxy = 850
+	a.Credentials["chatgpt_account_id"] = "identity-b"
+	if DrawingAccountModelCanServe(a, model, "generate") {
+		t.Fatal("identity change kept evidence")
+	}
+	a.Credentials["chatgpt_account_id"] = "identity-a"
+	if e := RecordDrawingModelEvidence(a, model, "generate", "uncertain", false, nil, errors.New("timeout")); e != nil {
+		t.Fatal(e)
+	}
+	if !DrawingAccountModelCanServe(a, model, "generate") {
+		t.Fatal("ambiguous request erased prior evidence")
+	}
+	if e := RecordDrawingModelEvidence(a, model, "generate", "rejected", false, nil, &DrawingImageTestError{Code: "access_forbidden", HTTPStatus: 403, Rejected: true}); e != nil {
+		t.Fatal(e)
+	}
+	if DrawingAccountModelCanServe(a, model, "generate") {
+		t.Fatal("explicit rejection kept capability")
+	}
+	paths, _ := filepath.Glob(filepath.Join(drawingEvidenceRoot(), "*.json"))
+	for _, p := range paths {
+		raw, _ := os.ReadFile(p)
+		if strings.Contains(string(raw), "secret-") {
+			t.Fatal("credential persisted")
+		}
+	}
+}
+func TestDrawingCapabilityMissingAndConflictingModelDeclarations(t *testing.T) {
+	t.Setenv("SUB2API_DRAWING_CAPABILITY_DIR", t.TempDir())
+	a := &Account{ID: 10, Platform: PlatformOpenAI, Type: AccountTypeOAuth}
+	model := "gpt-image-2.6-flare"
+	if e := RecordDrawingModelEvidence(a, model, "generate", "no-declaration", true, &OpenAIForwardResult{}, nil); e != nil {
+		t.Fatal(e)
+	}
+	e := DrawingAccountModelEvidence(a, model, "generate")
+	if e == nil || e.ModelConfirmed || !DrawingAccountModelCanServe(a, model, "generate") {
+		t.Fatal("missing declaration misrepresented")
+	}
+	if err := RecordDrawingModelEvidence(a, model, "generate", "wrong-model", true, &OpenAIForwardResult{UpstreamResponseModel: "gpt-image-2"}, nil); err != nil {
+		t.Fatal(err)
+	}
+	if DrawingAccountModelCanServe(a, model, "generate") {
+		t.Fatal("wrong-model response scheduled")
+	}
+	if !DrawingAccountModelCanServe(a, "gpt-image-2", "edit") {
+		t.Fatal("legacy model broken")
+	}
+}
