+func (s *AccountTestService) RunDrawingImageWithResult(ctx context.Context, account *Account, body []byte, edit bool) ([]byte, *OpenAIForwardResult, error) {
+	if s.openaiGatewayService == nil {
+		return []byte(`{"error":{"code":"drawing_executor_unavailable"}}`), nil, fmt.Errorf("绘图执行器不可用")
+	}
+	recorder := httptest.NewRecorder()
+	inner, _ := gin.CreateTestContext(recorder)
+	path := openAIImagesGenerationsEndpoint
+	if edit {
+		path = openAIImagesEditsEndpoint
+	}
+	inner.Request, _ = http.NewRequestWithContext(ctx, "POST", "http://localhost"+path, nil)
+	inner.Request.Header.Set("Content-Type", "application/json")
+	parsed, err := s.openaiGatewayService.ParseOpenAIImagesRequest(inner, body)
+	if err != nil {
+		return []byte(`{"error":{"code":"drawing_parameters_invalid"}}`), nil, fmt.Errorf("绘图参数无效: %w", err)
+	}
+	parsed.Stream = false
+	result, err := s.openaiGatewayService.ForwardImages(ctx, inner, account, body, parsed, "")
+	if err != nil || recorder.Code >= 400 {
+		return recorder.Body.Bytes(), result, drawingImageDiagnostic(err, recorder.Code, recorder.Body.Bytes())
+	}
+	return recorder.Body.Bytes(), result, nil
+}
