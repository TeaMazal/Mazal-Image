-		"safety system", "safety policy", "safety violation", "moderation",
-		"安全系统", "安全策略", "安全政策", "内容政策", "内容审核", "违规内容", "不适合生成",
-	} {
-		if strings.Contains(lower, marker) {
-			return true
-		}
