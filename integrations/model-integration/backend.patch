+func (h *AccountHandler) DrawingTestList(c *gin.Context) {
+	if !drawingFullAdmin(c) {
+		return
+	}
+	entries, e := os.ReadDir(drawingJobsRoot())
+	if e != nil && !os.IsNotExist(e) {
+		response.Error(c, 500, "无法读取测试历史")
+		return
+	}
+	jobs := []drawingTestJob{}
+	drawingJobsMu.Lock()
+	defer drawingJobsMu.Unlock()
+	for _, entry := range entries {
+		if filepath.Ext(entry.Name()) != ".json" {
+			continue
+		}
+		id := entry.Name()[:len(entry.Name())-5]
+		job, e := readDrawingJob(id)
+		if e != nil {
+			continue
+		}
+		if (job.State == "running" || job.State == "queued") && !drawingRunning[id] {
+			job.State = "unconfirmed"
+			job.Error = "服务重启前任务结果未确认，未自动重新提交"
+			_ = writeDrawingJob(job)
+		}
+		jobs = append(jobs, job)
+	}
+	sort.Slice(jobs, func(i, j int) bool { return jobs[i].Created > jobs[j].Created })
+	response.Success(c, gin.H{"items": jobs})
+}
+func (h *AccountHandler) DrawingTestImage(c *gin.Context) {
+	if !drawingFullAdmin(c) {
+		return
+	}
+	name := c.Param("name")
+	if !regexp.MustCompile(`^[a-zA-Z0-9_-]{8,80}-[0-9]+\.(png|jpg|webp|gif)$`).MatchString(name) {
+		response.BadRequest(c, "图片编号无效")
+		return
+	}
+	c.Header("Cache-Control", "private, no-store")
+	c.Header("X-Content-Type-Options", "nosniff")
+	c.File(filepath.Join(drawingJobsRoot(), name))
+}
+func (h *AccountHandler) DrawingTestDelete(c *gin.Context) {
+	if !drawingFullAdmin(c) {
+		return
+	}
+	id := c.Param("id")
+	if !drawingJobID.MatchString(id) {
+		response.BadRequest(c, "任务编号无效")
+		return
+	}
+	drawingJobsMu.Lock()
+	defer drawingJobsMu.Unlock()
+	if drawingRunning[id] {
+		response.Error(c, 409, "任务仍在执行，完成后再删除")
+		return
+	}
+	job, e := readDrawingJob(id)
+	if e != nil {
+		response.Error(c, 404, "任务不存在")
+		return
+	}
+	for _, name := range job.Images {
+		if filepath.Base(name) == name {
+			_ = os.Remove(filepath.Join(drawingJobsRoot(), name))
+		}
+	}
+	if e = os.Remove(filepath.Join(drawingJobsRoot(), id+".json")); e != nil {
+		response.Error(c, 500, "删除失败")
+		return
+	}
+	response.Success(c, gin.H{"deleted": true})
+}
