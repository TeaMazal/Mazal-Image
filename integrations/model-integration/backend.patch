+func TestDrawingCapabilityHydratesCandidateIdentity(t *testing.T) {
+	t.Setenv("SUB2API_DRAWING_CAPABILITY_DIR", t.TempDir())
+	proxy := int64(850)
+	full := &Account{ID: 1421, Platform: PlatformOpenAI, Type: AccountTypeOAuth, ProxyID: &proxy, Credentials: map[string]any{"chatgpt_account_id": "identity-a", "email": "fixture@example.invalid"}}
+	projection := *full
+	projection.Credentials = nil
+	model := "gpt-image-2.6"
+	if err := RecordDrawingModelEvidence(full, model, "generate", "fixture", true, &OpenAIForwardResult{}, nil); err != nil {
+		t.Fatal(err)
+	}
+	svc := &OpenAIGatewayService{schedulerSnapshot: &SchedulerSnapshotService{cache: &openAISnapshotCacheStub{snapshotAccounts: []*Account{&projection}, accountsByID: map[int64]*Account{full.ID: full}}}}
+	if !svc.drawingAccountCompatible(context.Background(), &projection, model, OpenAIImagesCapabilityBasic) {
+		t.Fatal("reduced scheduler identity hid verified model")
+	}
+	if svc.drawingAccountCompatible(WithDrawingImageOperation(context.Background(), true), &projection, model, OpenAIImagesCapabilityBasic) {
+		t.Fatal("generation evidence authorized unverified edit")
+	}
+	full.Credentials["chatgpt_account_id"] = "identity-b"
+	if svc.drawingAccountCompatible(context.Background(), &projection, model, OpenAIImagesCapabilityBasic) {
+		t.Fatal("new account identity reused stale evidence")
+	}
+}
