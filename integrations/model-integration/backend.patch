+func TestDrawingRecordDistinguishesRejectionAndUnknownOutcome(t *testing.T) {
+	t.Setenv("SUB2API_DRAWING_RECORD_DIR", t.TempDir())
+	for _, code := range []int{400, 401, 403, 429, 500, 502, 504} {
+		r := New(1, 2)
+		r.HTTPStatus = code
+		ParseResponse(&r, []byte(`{"error":{"message":"test"}}`), "application/json")
+		expected := "failed"
+		if code >= 500 {
+			expected = "unconfirmed"
+		}
+		if r.State != expected {
+			t.Fatalf("HTTP %d: %s", code, r.State)
+		}
+	}
+}
