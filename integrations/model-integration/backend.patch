-	return s.newOpenAIAccountFailoverError(
-		account,
-		upstreamErr.StatusCode,
-		headers,
-		responseBody,
-		upstreamErr.clientMessage(),
-		shouldDisable,
-		!shouldDisable && account.IsPoolMode() && account.IsPoolModeRetryableStatus(upstreamErr.StatusCode),
