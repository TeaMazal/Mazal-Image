+)
+
+func (h *AccountHandler) DrawingModels(c *gin.Context) {
+	if !drawingFullAdmin(c) {
+		return
+	}
+	id, e := strconv.ParseInt(c.Param("id"), 10, 64)
+	if e != nil {
+		response.BadRequest(c, "账号编号无效")
+		return
+	}
+	account, e := h.adminService.GetAccount(c.Request.Context(), id)
+	if e != nil || account.Platform != "openai" || account.Type != "oauth" || account.IsCredentialShadow() {
+		response.BadRequest(c, "账号不可用于绘图模型检查")
+		return
+	}
+	candidates := []gin.H{}
+	for _, model := range service.DrawingImageTestModels() {
+		adapterSupported := !account.IsOpenAIWeb() || model == "gpt-image-2"
+		candidates = append(candidates, gin.H{"id": model, "request_route": service.DrawingImageTestRoute(account, model), "mapped_model": account.GetMappedModel(model), "adapter_supported": adapterSupported, "account_allowed": account.IsModelSupported(model), "last_success_at": int64(0), "latest_test_at": int64(0), "latest_test_state": "untested", "generation_evidence":service.DrawingAccountModelEvidence(account,model,"generate"), "edit_evidence":service.DrawingAccountModelEvidence(account,model,"edit"), "customer_generation":service.DrawingAccountModelCanServe(account,model,"generate"), "customer_edit":service.DrawingAccountModelCanServe(account,model,"edit")})
+	}
+	entries, _ := os.ReadDir(drawingJobsRoot())
+	for _, entry := range entries {
+		if filepath.Ext(entry.Name()) != ".json" {
+			continue
+		}
+		job, e := readDrawingJob(strings.TrimSuffix(entry.Name(), ".json"))
+		if e != nil || job.AccountID != id {
+			continue
+		}
+		for _, candidate := range candidates {
+			if candidate["id"] != job.Model {
+				continue
+			}
+			if job.Updated > candidate["latest_test_at"].(int64) {
+				candidate["latest_test_at"] = job.Updated
+				candidate["latest_test_state"] = job.State
+			}
+			if len(job.Images) > 0 && job.Updated > candidate["last_success_at"].(int64) {
+				candidate["last_success_at"] = job.Updated
+			}
+		}
+	}
+	out := gin.H{"image_choices": candidates, "catalog": account.Extra["drawing_model_catalog"], "note": "上游模型目录、执行器支持和真实生图结果分别记录；模型列出不代表有生图权限。"}
+	if c.Query("refresh") == "true" {
+		models, e := h.accountTestService.DrawingDiscoveredModels(c.Request.Context(), account)
+		if e != nil {
+			out["discovery_error"] = e.Error()
+		} else {
+			catalog := gin.H{"models": models, "checked_at": time.Now().Unix()}
+			out["catalog"] = catalog
+			if e = h.adminService.UpdateAccountExtra(c.Request.Context(), id, map[string]any{"drawing_model_catalog": catalog}); e != nil {
+				out["discovery_error"] = "目录已读取，但快照保存失败"
+			}
+		}
+	}
+	response.Success(c, out)
+}
