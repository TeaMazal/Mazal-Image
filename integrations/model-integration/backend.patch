+package handler
+
+import (
+	"github.com/Wei-Shaw/sub2api/internal/pkg/drawingrecord"
+"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/Wei-Shaw/sub2api/internal/server/middleware"
+	"github.com/gin-gonic/gin"
+	"io"
+	"log"
+	"strconv"
+	"strings"
+	"time"
+)
+
+type drawingWriter struct {
+	gin.ResponseWriter
+	capture *drawingrecord.Capture
+}
+
+func (w *drawingWriter) Write(b []byte) (int, error) {
+	_, _ = w.capture.Write(b)
+	return w.ResponseWriter.Write(b)
+}
+func (w *drawingWriter) WriteString(s string) (int, error) { return w.Write([]byte(s)) }
+
+type drawingReadCloser struct {
+	io.Reader
+	io.Closer
+}
+
+// StartDrawingCapture runs after authentication and preserves transport semantics.
+func StartDrawingCapture(c *gin.Context) func() {
+	if c.GetBool("drawing_capture_active") {
+		return func() {}
+	}
+	key, ok := middleware.GetAPIKeyFromContext(c)
+	if !ok || key == nil {
+		return func() {}
+	}
+	req, e := drawingrecord.NewCapture()
+	if e != nil {
+		log.Print("drawing record capture unavailable")
+		return func() {}
+	}
+	res, e := drawingrecord.NewCapture()
+	if e != nil {
+		req.Close()
+		return func() {}
+	}
+	r := drawingrecord.New(key.UserID, key.ID)
+	r.Mode = "generate"
+	if strings.Contains(c.Request.URL.Path, "edits") {
+		r.Mode = "edit"
+	}
+	// Optional client grouping is always scoped to the authenticated user and key.
+	for header, target := range map[string]*string{"X-Drawing-Round-Id": &r.RoundID, "X-Drawing-Conversation-Id": &r.ConversationID} {
+		s := c.GetHeader(header)
+		if len(s) <= 128 {
+			*target = s
+		}
+	}
+	if n, e := strconv.Atoi(c.GetHeader("X-Drawing-Round-Total")); e == nil && n > 0 && n <= 100 {
+		r.RoundTotal = n
+	}
+	if e = drawingrecord.Save(r); e != nil {
+		req.Close()
+		res.Close()
+		return func() {}
+	}
+	c.Set("drawing_capture_active", true)
+	drawingrecord.Active.Store(r.ID, true)
+	original := c.Writer
+	wrapped := &drawingWriter{original, res}
+	c.Writer = wrapped
+	body := c.Request.Body
+	if body != nil {
+		c.Request.Body = &drawingReadCloser{io.TeeReader(body, req), body}
+	}
+	started := time.Now()
+	return func() {
+		defer req.Close()
+		defer res.Close()
+		defer drawingrecord.Active.Delete(r.ID)
+		c.Writer = original
+		defer func() {
+			if recover() != nil {
+				log.Print("drawing record archive failed; generation was not retried")
+			}
+		}()
+		execution:=drawingrecord.Execution{AccountID:c.GetInt64("drawing_record_account_id"),ProxyID:c.GetInt64("drawing_record_proxy_id")}
+        if value,ok:=c.Get("drawing_record_execution");ok {if result,ok:=value.(*service.OpenAIForwardResult);ok && result!=nil {execution.MappedModel=result.UpstreamModel;execution.ObservedModel=result.UpstreamResponseModel;execution.ModelConflict=result.UpstreamResponseModelConflict;execution.Endpoint=result.UpstreamEndpoint}}
+        if execution.AccountID>0 {r.Executions=[]drawingrecord.Execution{execution}}
+        r.Duration = time.Since(started).Milliseconds()
+		r.HTTPStatus = original.Status()
+		r.RequestID = original.Header().Get("X-Request-Id")
+		if id := c.GetString("drawing_record_usage_id"); id != "" {
+			r.RequestID = id
+		}
+		drawingrecord.ParseRequest(&r, req.Bytes(), c.GetHeader("Content-Type"))
+		drawingrecord.ParseResponse(&r, res.Bytes(), original.Header().Get("Content-Type"))
+		if req.Truncated || res.Truncated || req.Failed || res.Failed {
+			r.Note = "归档不完整，请以用户结果与主站账单为准"
+		}
+		if e = drawingrecord.Save(r); e != nil {
+			log.Print("drawing record persistence failed; generation was not retried")
+		}
+	}
+}
