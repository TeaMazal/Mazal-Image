+package service
+
+import (
+	"context"
+	"github.com/Wei-Shaw/sub2api/internal/pkg/ctxkey"
+	"testing"
+)
+
+func TestDrawingBillingRequestIDMatchesLedger(t *testing.T) {
+	ctx := context.WithValue(context.Background(), ctxkey.ClientRequestID, "customer-call")
+	got := DrawingUsageRequestID(ctx, "upstream-call")
+	if got != "client:customer-call" || resolveUsageBillingRequestID(ctx, got) != got {
+		t.Fatal("drawing record and ledger identities diverged")
+	}
+	got = DrawingUsageRequestID(context.Background(), "")
+	if got == "" || resolveUsageBillingRequestID(context.Background(), got) != got {
+		t.Fatal("fallback identity was not pinned")
+	}
+}
