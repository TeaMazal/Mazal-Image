+package service
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"time"
+)
+
+// DrawingModelEvidence contains only administrative test facts, never credentials.
+// A saved image proves this route returned an image; ModelConfirmed separately
+// states whether the upstream actually named the requested model.
+type DrawingModelEvidence struct {
+	AccountID      int64  `json:"account_id"`
+	Model          string `json:"model"`
+	MappedModel    string `json:"mapped_model"`
+	ObservedModel  string `json:"observed_model,omitempty"`
+	ModelConflict  bool   `json:"model_conflict,omitempty"`
+	ModelConfirmed bool   `json:"model_confirmed"`
+	Operation      string `json:"operation"`
+	Route          string `json:"request_route"`
+	Endpoint       string `json:"upstream_endpoint,omitempty"`
+	ProxyID        int64  `json:"proxy_id,omitempty"`
+	Fingerprint    string `json:"fingerprint"`
+	State          string `json:"state"`
+	ErrorCode      string `json:"error_code,omitempty"`
+	HTTPStatus     int    `json:"http_status,omitempty"`
+	CheckedAt      int64  `json:"checked_at"`
+	JobID          string `json:"job_id,omitempty"`
+}
+
+type drawingOperationKey struct{}
+
+func WithDrawingImageOperation(ctx context.Context, edit bool) context.Context {
+	op := "generate"
+	if edit {
+		op = "edit"
+	}
+	return context.WithValue(ctx, drawingOperationKey{}, op)
+}
+func drawingOperation(ctx context.Context) string {
+	op, _ := ctx.Value(drawingOperationKey{}).(string)
+	if op == "edit" {
+		return op
+	}
+	return "generate"
+}
+func drawingEvidenceRoot() string {
+	if root := os.Getenv("SUB2API_DRAWING_CAPABILITY_DIR"); root != "" {
+		return root
+	}
+	return "/app/data/drawing-capabilities"
+}
+func drawingEvidencePath(a *Account, model, operation string) string {
+	digest := sha256.Sum256([]byte(model + "\x00" + operation))
+	return filepath.Join(drawingEvidenceRoot(), fmt.Sprintf("%d-%x.json", a.ID, digest[:12]))
+}
+func drawingIdentityFingerprint(a *Account, model string) string {
+	proxy := int64(0)
+	if a.ProxyID != nil {
+		proxy = *a.ProxyID
+	}
+	// Normal access-token renewal does not alter account capability. Binding,
+	// account source, proxy and model mapping changes do invalidate the evidence.
+	raw, _ := json.Marshal([]any{a.ID, a.Platform, a.Type, a.IsOpenAIWeb(), a.GetCredential("chatgpt_account_id"), a.GetCredential("email"), proxy, a.GetMappedModel(model)})
+	digest := sha256.Sum256(raw)
+	return hex.EncodeToString(digest[:])
+}
+
+var drawingEvidenceCache = struct {
+	sync.Mutex
+	entries map[string]drawingCachedEvidence
+}{entries: map[string]drawingCachedEvidence{}}
+
+type drawingCachedEvidence struct {
+	evidence *DrawingModelEvidence
+	checked  time.Time
+}
+
+func DrawingAccountModelEvidence(a *Account, model, operation string) *DrawingModelEvidence {
+	if a == nil {
+		return nil
+	}
+	if operation != "edit" {
+		operation = "generate"
+	}
+	path := drawingEvidencePath(a, model, operation)
+	drawingEvidenceCache.Lock()
+	defer drawingEvidenceCache.Unlock()
+	cached, ok := drawingEvidenceCache.entries[path]
+	if !ok || time.Since(cached.checked) > 5*time.Second {
+		var evidence DrawingModelEvidence
+		raw, err := os.ReadFile(path)
+		cached = drawingCachedEvidence{checked: time.Now()}
+		if err == nil && json.Unmarshal(raw, &evidence) == nil {
+			cached.evidence = &evidence
+		}
+		// Bound only this small metadata cache, not account or generation resources.
+		if len(drawingEvidenceCache.entries) > 10000 {
+			drawingEvidenceCache.entries = map[string]drawingCachedEvidence{}
+		}
+		drawingEvidenceCache.entries[path] = cached
+	}
+	if cached.evidence == nil || cached.evidence.Fingerprint != drawingIdentityFingerprint(a, model) {
+		return nil
+	}
+	result := *cached.evidence
+	return &result
+}
+func DrawingAccountModelCanServe(a *Account, model, operation string) bool {
+	if a == nil {
+		return false
+	}
+	// Existing Web/2.0 and provider API-key behavior is preserved. New OAuth
+	// variants require an image saved by the shared administrator test adapter.
+	if a.Type == AccountTypeAPIKey {
+		return true
+	}
+	if a.IsOpenAIWeb() {
+		return model == "gpt-image-2" && a.GetMappedModel(model) == "gpt-image-2"
+	}
+	mapped := a.GetMappedModel(model)
+	if model == "gpt-image-2" && !strings.HasPrefix(mapped, "gpt-image-2.5") && !strings.HasPrefix(mapped, "gpt-image-2.6") {
+		return true
+	}
+	e := DrawingAccountModelEvidence(a, model, operation)
+	return e != nil && e.State == "image_verified" && !e.ModelConflict && (e.ObservedModel == "" || e.ModelConfirmed)
+}
+func (s *OpenAIGatewayService) drawingAccountCompatible(ctx context.Context, a *Account, model string, required OpenAIImagesCapability) bool {
+	if required == "" {
+		return true
+	}
+	// Candidate snapshots intentionally omit identity credentials. Evidence must
+	// be evaluated against the hydrated account, never a reduced projection.
+	if s != nil && s.schedulerSnapshot != nil {
+		full, err := s.hydrateSelectedAccount(ctx, a)
+		if err != nil || full == nil {
+			return false
+		}
+		a = full
+	}
+	return DrawingAccountModelCanServe(a, model, drawingOperation(ctx))
+}
+func RecordDrawingModelEvidence(a *Account, model, operation, jobID string, saved bool, result *OpenAIForwardResult, runErr error) error {
+	if a == nil || !IsDrawingImageTestModel(model) {
+		return nil
+	}
+	e := DrawingModelEvidence{AccountID: a.ID, Model: model, MappedModel: a.GetMappedModel(model), Operation: operation, Route: DrawingImageTestRoute(a, model), Fingerprint: drawingIdentityFingerprint(a, model), State: "unconfirmed", CheckedAt: time.Now().Unix(), JobID: jobID}
+	if a.ProxyID != nil {
+		e.ProxyID = *a.ProxyID
+	}
+	if result != nil {
+		e.Endpoint = result.UpstreamEndpoint
+		e.ObservedModel = result.UpstreamResponseModel
+		e.ModelConflict = result.UpstreamResponseModelConflict
+		e.ModelConfirmed = e.ObservedModel != "" && !e.ModelConflict && e.ObservedModel == e.MappedModel
+	}
+	if saved {
+		e.State = "image_verified"
+	} else if diagnostic, ok := runErr.(*DrawingImageTestError); ok {
+		e.ErrorCode = diagnostic.Code
+		e.HTTPStatus = diagnostic.HTTPStatus
+		if diagnostic.Rejected {
+			e.State = "rejected"
+		}
+	}
+	// Quota/parameter failures do not prove model entitlement was removed.
+	// Preserve a previously verified route; normal quota scheduling still applies.
+	if e.HTTPStatus == 429 || e.ErrorCode == "request_rejected" {
+		if prior := DrawingAccountModelEvidence(a, model, operation); prior != nil && prior.State == "image_verified" {
+			prior.ErrorCode = e.ErrorCode
+			prior.HTTPStatus = e.HTTPStatus
+			prior.CheckedAt = e.CheckedAt
+			prior.JobID = e.JobID
+			e = *prior
+		} else if e.HTTPStatus == 429 {
+			e.State = "quota_limited"
+		}
+	}
+	// Uncertain requests never erase a previous success or assert rejection.
+	if e.State == "unconfirmed" {
+		return nil
+	}
+	if e.ModelConflict || e.ObservedModel != "" && !e.ModelConfirmed {
+		e.State = "model_mismatch"
+	}
+	if err := os.MkdirAll(drawingEvidenceRoot(), 0700); err != nil {
+		return err
+	}
+	raw, err := json.Marshal(e)
+	if err != nil {
+		return err
+	}
+	f, err := os.CreateTemp(drawingEvidenceRoot(), ".evidence-")
+	if err != nil {
+		return err
+	}
+	name := f.Name()
+	defer os.Remove(name)
+	if _, err = f.Write(raw); err == nil {
+		err = f.Sync()
+	}
+	f.Close()
+	if err != nil {
+		return err
+	}
+	path := drawingEvidencePath(a, model, operation)
+	if err = os.Rename(name, path); err != nil {
+		return err
+	}
+	drawingEvidenceCache.Lock()
+	delete(drawingEvidenceCache.entries, path)
+	drawingEvidenceCache.Unlock()
+	return nil
+}
+func (s *OpenAIGatewayService) DrawingCustomerImageModels(ctx context.Context, key *APIKey, operation string) ([]string, error) {
+	models := []string{}
+	if key == nil || key.Group == nil || key.GroupID == nil || !key.Group.AllowImageGeneration || key.Group.Platform != PlatformOpenAI {
+		return models, nil
+	}
+	accounts, err := s.listSchedulableAccounts(ctx, key.GroupID, PlatformOpenAI)
+	if err != nil {
+		return nil, err
+	}
+	hydrated := make([]Account, 0, len(accounts))
+	for i := range accounts {
+		full, err := s.hydrateSelectedAccount(ctx, &accounts[i])
+		if err != nil {
+			return nil, err
+		}
+		if full != nil {
+			hydrated = append(hydrated, *full)
+		}
+	}
+	for _, model := range DrawingImageTestModels() {
+		if key.Group.ModelAllowlistEnabled() && len(key.Group.ModelAllowlist.FilterForListing([]string{model})) == 0 {
+			continue
+		}
+		for i := range hydrated {
+			a := &hydrated[i]
+			if a.IsModelSupported(model) && a.SupportsOpenAIImageCapability(OpenAIImagesCapabilityBasic) && DrawingAccountModelCanServe(a, model, operation) {
+				models = append(models, model)
+				break
+			}
+		}
+	}
+	return models, nil
+}
