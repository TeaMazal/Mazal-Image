+	"github.com/gin-gonic/gin"
+)
+
+var drawingJobID = regexp.MustCompile(`^[a-zA-Z0-9_-]{8,80}$`)
+var drawingJobsMu sync.Mutex
+var drawingRunning = map[string]bool{}
+
+type drawingExecution struct {
+    MappedModel string `json:"mapped_model"`
+    ObservedModel string `json:"observed_model,omitempty"`
+    ModelConflict bool `json:"model_conflict,omitempty"`
+    Endpoint string `json:"upstream_endpoint,omitempty"`
+    RequestID string `json:"request_id,omitempty"`
+}
+type drawingTestJob struct {
+    Operation string `json:"operation,omitempty"`
+    Route string `json:"request_route,omitempty"`
+    ProxyID int64 `json:"proxy_id,omitempty"`
+    Executions []drawingExecution `json:"executions,omitempty"`
+    EvidenceError string `json:"evidence_error,omitempty"`
+	ID           string   `json:"id"`
+	Conversation string   `json:"conversation_id"`
+	AccountID    int64    `json:"account_id"`
+	Model        string   `json:"model"`
+	Prompt       string   `json:"prompt"`
+	Count        int      `json:"n"`
+	State        string   `json:"state"`
+	Created      int64    `json:"created_at"`
+	Updated      int64    `json:"updated_at"`
+	Images       []string `json:"images"`
+	Error        string   `json:"error,omitempty"`
+	ErrorCode    string   `json:"error_code,omitempty"`
+	HTTPStatus   int      `json:"http_status,omitempty"`
+	RequestHash  string   `json:"request_hash,omitempty"`
+}
+
+func drawingJobsRoot() string {
+	p := os.Getenv("SUB2API_DRAWING_TEST_DIR")
+	if p == "" {
+		p = "/app/data/drawing-tests"
+	}
+	return p
+}
+func writeDrawingJob(job drawingTestJob) error {
+	b, e := json.Marshal(job)
+	if e != nil {
+		return e
+	}
+	p := filepath.Join(drawingJobsRoot(), job.ID+".json")
+	temp := p + ".tmp"
+	if e = os.WriteFile(temp, b, 0600); e != nil {
+		return e
+	}
+	return os.Rename(temp, p)
+}
+func readDrawingJob(id string) (drawingTestJob, error) {
+	var job drawingTestJob
+	b, e := os.ReadFile(filepath.Join(drawingJobsRoot(), id+".json"))
+	if e == nil {
+		e = json.Unmarshal(b, &job)
+	}
+	return job, e
+}
