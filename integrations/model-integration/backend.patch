-func calcLoadSkewByMoments(sum float64, sumSquares float64, count int) float64 {
-	if count <= 1 {
-		return 0
-	}
-	mean := sum / float64(count)
-	variance := sumSquares/float64(count) - mean*mean
-	if variance < 0 {
-		variance = 0
-	}
-	return math.Sqrt(variance)
