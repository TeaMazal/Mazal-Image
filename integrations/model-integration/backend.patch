-	}
-
-	// Surface the real upstream error to the client.
-	upErr := openAIImagesUpstreamErrorFromHTTP(resp.StatusCode, resp.Header, body)
-	writeOpenAIImagesUpstreamErrorResponse(c, upErr)
-	return nil, upErr
-}
