+ return out,nil
+}
+
+func(h *AccountHandler) DrawingOAuthFinish(c *gin.Context){
+ if !drawingFullAdmin(c){return}
+ var req struct{SessionID string `json:"session_id"`;Callback string `json:"callback"`}
+ c.Request.Body=http.MaxBytesReader(c.Writer,c.Request.Body,32768)
+ if c.ShouldBindJSON(&req)!=nil{response.BadRequest(c,"请填写回调地址");return}
+ drawingOAuthMu.Lock();session:=drawingOAuthSessions[req.SessionID]
