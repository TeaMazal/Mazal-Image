+"""Exchange one administrator's Web PKCE code; credentials only on private stdin/stdout."""
+import json
+import sys
+import time
+from curl_cffi import requests
+from services.openai_oauth import common_headers, platform_oauth_client_id
+
+def main():
+    value=json.loads(sys.stdin.read(65536))
+    if value.get('redirect_uri') != 'https://platform.openai.com/auth/callback':
+        raise ValueError('invalid redirect')
+    proxy=value.get('proxy_url') or None
+    with requests.Session(impersonate='chrome', proxy=proxy, verify=True) as session:
+        response=session.post('https://auth.openai.com/api/accounts/oauth/token',headers=common_headers,
+            json={'grant_type':'authorization_code','client_id':platform_oauth_client_id,
+                  'code':value['code'],'code_verifier':value['verifier'],'redirect_uri':value['redirect_uri']},
+            timeout=60,allow_redirects=False)
+        if response.status_code != 200:
+            raise ValueError('authorization exchange failed')
+        raw=response.json()
+    if not isinstance(raw.get('access_token'),str) or not raw['access_token']:
+        raise ValueError('missing access token')
+    result={key:raw[key] for key in ('access_token','refresh_token','id_token') if isinstance(raw.get(key),str)}
+    result.update(client_id=platform_oauth_client_id,source_type='web')
+    if isinstance(raw.get('expires_in'),(int,float)):
+        result['expires_at']=int(time.time()+raw['expires_in'])
+    print(json.dumps(result,separators=(',',':')),flush=True)
+
+if __name__=='__main__':
+    try:
+        main()
+    except Exception:
+        # Never print upstream response bodies, callback URLs, or token values.
+        sys.exit(1)
