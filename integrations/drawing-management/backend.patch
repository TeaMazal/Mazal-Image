+ result:=&DrawingProxyHandler{manager:service.NewDrawingProxyManager(h.adminService,settings)}
+ workerrole.Start("drawing-proxy-maintenance",func(){go func(){ticker:=time.NewTicker(time.Minute);defer ticker.Stop();for range ticker.C{ctx,cancel:=context.WithTimeout(context.Background(),10*time.Minute);result.manager.Tick(ctx);cancel()}}()})
