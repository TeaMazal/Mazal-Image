+}
+
+func(m *DrawingProxyManager) SaveSubscription(ctx context.Context,id,name,address,userAgent string,enabled bool,hours int)(string,error) {
+ if strings.TrimSpace(name)=="" || hours<1 || hours>168{return "",fmt.Errorf("请填写订阅名称，更新间隔为 1–168 小时")}
+ m.mu.Lock();defer m.mu.Unlock();cfg,err:=m.load(ctx);if err!=nil{return "",err}
