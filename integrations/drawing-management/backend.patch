+}
+
+func(m *DrawingProxyManager) findProxy(ctx context.Context,input *CreateProxyInput)(*Proxy,error) {
+ for page:=1;;page++ {items,total,e:=m.admin.ListProxies(ctx,page,100,"","",input.Host,"id","asc");if e!=nil{return nil,e}
+  for i:=range items {p:=&items[i];if p.Protocol==input.Protocol && p.Host==input.Host && p.Port==input.Port && p.Username==input.Username && p.Password==input.Password{return p,nil}}
+  if len(items)==0 || int64(page*100)>=total{return nil,nil}
+ }
+}
+
+func(m *DrawingProxyManager) SaveCore(ctx context.Context,core DrawingProxyCore)error {
+ u,e:=url.Parse(core.APIURL);if e!=nil || u.Hostname()=="" || (u.Scheme!="http" && u.Scheme!="https") || u.User!=nil || core.ListenHost=="" || strings.ContainsAny(core.ListenHost,"/ :") || core.PortStart<1024 || core.PortStart>60000{return fmt.Errorf("代理核心地址或端口配置无效")}
+ m.mu.Lock();defer m.mu.Unlock();cfg,e:=m.load(ctx);if e!=nil{return e}
+ if core.Secret==""{core.Secret=cfg.Core.Secret}
+ for _,s:=range cfg.Subscriptions{for _,n:=range s.Nodes{if n.CorePort!=0 && (!core.Enabled || core.ListenHost!=cfg.Core.ListenHost){return fmt.Errorf("已有节点使用核心，请先解除绑定并移除对应节点再停用或变更主机")}}}
+ cfg.Core=core;return m.save(ctx,cfg)
+}
+
+func(m *DrawingProxyManager) ApplyCore(ctx context.Context)error {m.mu.Lock();defer m.mu.Unlock();cfg,e:=m.load(ctx);if e!=nil{return e};return m.applyCore(ctx,&cfg)}
+func(m *DrawingProxyManager) applyCore(ctx context.Context,cfg *DrawingProxyConfig)error {
+ if !cfg.Core.Enabled{return fmt.Errorf("代理核心未启用")}
+ proxies:=[]map[string]any{};listeners:=[]map[string]any{}
+ for _,s:=range cfg.Subscriptions{for _,n:=range s.Nodes{
+  if n.CorePort==0 || n.ProxyID==0 || n.Missing || n.Mode!="core"{continue}
