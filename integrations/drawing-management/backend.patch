+ session:=&drawingOAuthSession{Source:req.Source,ProxyID:req.ProxyID,GroupIDs:req.GroupIDs,AccountID:req.AccountID,Created:time.Now()}
+ if req.ProxyID!=nil {
+  proxy,e:=h.adminService.GetProxy(c.Request.Context(),*req.ProxyID);if e!=nil{response.BadRequest(c,"所选代理不存在");return}
+  session.ProxyURL,e=service.DrawingProxyURL(&service.Account{ProxyID:req.ProxyID,Proxy:proxy});if e!=nil{response.BadRequest(c,e.Error());return}
