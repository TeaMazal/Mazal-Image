+func DrawingRuntimeHandler(settings *service.SettingService)gin.HandlerFunc{
+ return func(c *gin.Context){
+  if !drawingFullAdmin(c){return}
+  previous,e:=service.LoadDrawingRuntime(c.Request.Context(),settings);if e!=nil{response.Error(c,503,"执行设置不可读，未修改");return}
+  cfg:=previous
+  if c.Request.Method=="POST"{
+   c.Request.Body=http.MaxBytesReader(c.Writer,c.Request.Body,16384)
+   if c.ShouldBindJSON(&cfg)!=nil{response.BadRequest(c,"执行参数格式无效");return}
+   if cfg.SolverKey==""{cfg.SolverKey=previous.SolverKey}
+   if e=service.ValidateDrawingRuntime(cfg);e!=nil{response.BadRequest(c,e.Error());return}
+   raw,_:=json.Marshal(cfg);if e=settings.SetCustomSetting(c.Request.Context(),service.DrawingRuntimeSetting,string(raw));e!=nil{response.Error(c,500,"保存执行设置失败");return}
+  }
+  hasKey:=cfg.SolverKey!="";cfg.SolverKey=""
+  response.Success(c,gin.H{"config":cfg,"has_solver_key":hasKey})
+ }
+}
