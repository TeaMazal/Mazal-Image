+func drawingAccountSummary(a service.Account) gin.H {
+ source:="codex";if a.IsOpenAIWeb(){source="web"}
+ return gin.H{"id":a.ID,"name":a.Name,"email":a.GetCredential("email"),"source":source,"status":a.Status,"schedulable":a.Schedulable,"group_ids":a.GroupIDs,"proxy_id":a.ProxyID,"has_refresh_token":a.GetCredential("refresh_token")!="","expires_at":a.Credentials["expires_at"],"quota":a.Extra["web_image_usage"],"error_message":a.ErrorMessage,"model_mapping":a.Credentials["model_mapping"]}
