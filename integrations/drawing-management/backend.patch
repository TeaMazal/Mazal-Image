+func TestDrawingEngineBridgeDeniesAccountAndGenerationAPIs(t *testing.T){
+ for _,path:=range []string{"/api/accounts","/api/cpa/pools","/api/sub2api/servers","/v1/images/generations","/api/image-tasks/generations","/api/auth/users","/images/../config.json"}{for _,method:=range []string{"GET","POST","PUT","DELETE"}{if drawingEngineAllowed(method,path){t.Fatalf("allowed privileged legacy path %s %s",method,path)}}}
