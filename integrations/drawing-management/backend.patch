+}
+
+func drawingExchangeWeb(ctx context.Context,session *drawingOAuthSession,code string)([]byte,error){
+ python:=os.Getenv("SUB2API_WEB_PYTHON");if python==""{python="/opt/web-runtime/bin/python"}
+ worker:=os.Getenv("SUB2API_WEB_WORKER");if worker==""{worker="/app/resources/chatgpt_web/worker.py"}
+ body,_:=json.Marshal(map[string]any{"code":code,"verifier":session.Verifier,"redirect_uri":session.Redirect,"proxy_url":session.ProxyURL})
+ cmd:=exec.CommandContext(ctx,python,"-B",filepath.Join(filepath.Dir(worker),"drawing_oauth_exchange.py"));cmd.Stdin=bytes.NewReader(body);cmd.Stderr=io.Discard
