+package admin
+
+import (
+ "context"
+ "crypto/sha256"
+ "encoding/base64"
+ "encoding/hex"
+ "encoding/json"
+ "errors"
+ "fmt"
+ "net/http"
+ "os"
+ "path/filepath"
+ "regexp"
+ "sort"
+ "strings"
+ "sync"
+ "time"
+
+ "github.com/gin-gonic/gin"
+ "github.com/Wei-Shaw/sub2api/internal/pkg/response"
+)
+
+var drawingJobID=regexp.MustCompile(`^[a-zA-Z0-9_-]{8,80}$`)
+var drawingJobsMu sync.Mutex
+var drawingRunning=map[string]bool{}
+type drawingTestJob struct {
+ ID string `json:"id"`
+ Conversation string `json:"conversation_id"`
+ AccountID int64 `json:"account_id"`
+ Model string `json:"model"`
+ Prompt string `json:"prompt"`
+ Count int `json:"n"`
+ State string `json:"state"`
+ Created int64 `json:"created_at"`
+ Updated int64 `json:"updated_at"`
+ Images []string `json:"images"`
+ Error string `json:"error,omitempty"`
+ RequestHash string `json:"request_hash,omitempty"`
+}
+func drawingJobsRoot()string {p:=os.Getenv("SUB2API_DRAWING_TEST_DIR");if p==""{p="/app/data/drawing-tests"};return p}
+func writeDrawingJob(job drawingTestJob)error {
+ b,e:=json.Marshal(job);if e!=nil{return e};p:=filepath.Join(drawingJobsRoot(),job.ID+".json");temp:=p+".tmp"
+ if e=os.WriteFile(temp,b,0600);e!=nil{return e};return os.Rename(temp,p)
+}
+func readDrawingJob(id string)(drawingTestJob,error){var job drawingTestJob;b,e:=os.ReadFile(filepath.Join(drawingJobsRoot(),id+".json"));if e==nil{e=json.Unmarshal(b,&job)};return job,e}
+
+func(h *AccountHandler) DrawingTestSubmit(c *gin.Context) {
+ if !drawingFullAdmin(c){return}
+ id:=c.Param("id");if !drawingJobID.MatchString(id){response.BadRequest(c,"任务编号无效");return}
+ var req struct {
+  Conversation string `json:"conversation_id"`
+  AccountID int64 `json:"account_id"`
+  Model string `json:"model"`
+  Prompt string `json:"prompt"`
+  Count int `json:"n"`
+  Size string `json:"size"`
+  Quality string `json:"quality"`
+  Images []string `json:"images"`
+ }
+ c.Request.Body=http.MaxBytesReader(c.Writer,c.Request.Body,50*1024*1024)
+ if c.ShouldBindJSON(&req)!=nil || !drawingJobID.MatchString(req.Conversation) || req.AccountID<=0 || req.Prompt=="" || len(req.Prompt)>32000 || req.Count<1 || req.Count>10 || len(req.Images)>8 {response.BadRequest(c,"请检查对话、账号、提示词和图片数量");return}
+ account,e:=h.adminService.GetAccount(c.Request.Context(),req.AccountID)
+ if e!=nil || account.Platform!="openai" || account.Type!="oauth" || account.IsCredentialShadow(){response.BadRequest(c,"请选择有效的 Web 或 Codex 账号");return}
+ if !account.IsModelSupported(req.Model){response.BadRequest(c,"账号模型配置不允许此模型");return}
+ if req.Model!="gpt-image-2" && req.Model!="gpt-image-2.5" && req.Model!="gpt-image-2.6"{response.BadRequest(c,"请选择已支持的图片模型");return}
+ if account.IsOpenAIWeb() && (req.Model!="gpt-image-2" || account.GetMappedModel(req.Model)!="gpt-image-2"){response.BadRequest(c,"Web 执行器目前只支持 gpt-image-2，请选择 Codex 账号测试其他模型");return}
+ for _,image:=range req.Images {
+  if !drawingValidReference(image){response.BadRequest(c,"参考图必须是有效的 PNG、JPEG 或 WebP 文件，单张不超过 8 MB");return}
+ }
+ body:=map[string]any{"model":req.Model,"prompt":req.Prompt,"n":req.Count,"size":req.Size,"quality":req.Quality,"response_format":"b64_json","stream":false}
+ if len(req.Images)>0{images:=[]map[string]string{};for _,image:=range req.Images{images=append(images,map[string]string{"image_url":image})};body["images"]=images}
+ raw,e:=json.Marshal(body);if e!=nil{response.BadRequest(c,"参考图片无效");return}
+ hashBytes,_:=json.Marshal(req);digest:=sha256.Sum256(hashBytes);requestHash:=hex.EncodeToString(digest[:])
+ drawingJobsMu.Lock()
+ if existing,e:=readDrawingJob(id);e==nil {
+  drawingJobsMu.Unlock();if existing.RequestHash!=requestHash{response.Error(c,409,"同一任务编号已提交其他内容，请先核对原任务");return};response.Success(c,existing);return
+ }else if !errors.Is(e,os.ErrNotExist){drawingJobsMu.Unlock();response.Error(c,409,"已有任务记录无法读取，未重复提交");return}
+ if e=os.MkdirAll(drawingJobsRoot(),0700);e!=nil{drawingJobsMu.Unlock();response.Error(c,500,"测试记录目录不可写");return}
+ job:=drawingTestJob{ID:id,Conversation:req.Conversation,AccountID:req.AccountID,Model:req.Model,Prompt:req.Prompt,Count:req.Count,State:"queued",Created:time.Now().Unix(),Updated:time.Now().Unix(),Images:[]string{}}
+ job.RequestHash=requestHash
+ if e=writeDrawingJob(job);e!=nil{drawingJobsMu.Unlock();response.Error(c,500,"无法保存测试任务，未提交生成");return}
+ drawingRunning[id]=true;drawingJobsMu.Unlock()
+ go h.runDrawingTest(job,raw,len(req.Images)>0)
+ response.Success(c,job)
+}
+
+func drawingValidReference(value string)bool {
+ parts:=strings.SplitN(value,",",2);if len(parts)!=2 || len(parts[1])>12*1024*1024{return false}
+ mime:=strings.TrimSuffix(strings.TrimPrefix(parts[0],"data:"),";base64")
+ if parts[0]!="data:"+mime+";base64" || (mime!="image/png" && mime!="image/jpeg" && mime!="image/webp"){return false}
+ data,err:=base64.StdEncoding.DecodeString(parts[1]);return err==nil && len(data)>0 && len(data)<=8*1024*1024 && http.DetectContentType(data)==mime
+}
+
+func(h *AccountHandler) runDrawingTest(job drawingTestJob,raw []byte,edit bool) {
+ defer func(){
+  if recover()!=nil{job.State="unconfirmed";job.Error="测试执行中断，已保存结果保留；未自动重新提交";job.Updated=time.Now().Unix();_=writeDrawingJob(job)}
+  drawingJobsMu.Lock();delete(drawingRunning,job.ID);drawingJobsMu.Unlock()
+ }()
+ ctx,cancel:=context.WithTimeout(context.Background(),time.Duration(job.Count)*20*time.Minute);defer cancel()
+ fail:=func(message string){job.State="failed";job.Error=message;job.Updated=time.Now().Unix();_=writeDrawingJob(job)}
+ account,e:=h.adminService.GetAccount(ctx,job.AccountID);if e!=nil{fail("账号不可用，未提交生成");return}
+ if h.concurrencyService==nil{fail("并发控制服务不可用，未提交生成");return}
+ slot,e:=h.concurrencyService.AcquireAccountSlot(ctx,account.ID,account.Concurrency)
+ if e!=nil || slot==nil || !slot.Acquired{fail("账号当前繁忙，请稍后新建测试");return};defer slot.ReleaseFunc()
+ job.State="running";job.Updated=time.Now().Unix();if e=writeDrawingJob(job);e!=nil{return}
+ var single map[string]any
+ if json.Unmarshal(raw,&single)!=nil{fail("任务参数无法读取，未提交生成");return}
+ single["n"]=1;singleRaw,_:=json.Marshal(single)
+ for index:=0;index<job.Count;index++ {
+ output,runErr:=h.accountTestService.RunDrawingImage(ctx,account,singleRaw,edit)
+  var result struct {Data []struct{Base64 string `json:"b64_json"`} `json:"data"`; Error struct{Code string `json:"code"`} `json:"error"`}
+ savedBefore:=len(job.Images)
+ if json.Unmarshal(output,&result)==nil {
+  for _,item:=range result.Data {
+   if len(job.Images)>savedBefore{break};data,e:=base64.StdEncoding.DecodeString(item.Base64);if e!=nil || len(data)==0 || len(data)>25*1024*1024{continue}
+   mime:=http.DetectContentType(data);ext:="";switch mime{case "image/png":ext="png";case "image/jpeg":ext="jpg";case "image/webp":ext="webp";case "image/gif":ext="gif"};if ext==""{continue}
+   name:=fmt.Sprintf("%s-%d.%s",job.ID,index,ext);if e=os.WriteFile(filepath.Join(drawingJobsRoot(),name),data,0600);e!=nil{continue};job.Images=append(job.Images,name)
+  }
+ }
+ job.Updated=time.Now().Unix()
+ // Persist each image before requesting another. A disk failure never causes
+ // further upstream consumption, and refreshes can display partial progress.
+ if e=writeDrawingJob(job);e!=nil{return}
+ if runErr!=nil || len(job.Images)==savedBefore {if drawingJobID.MatchString(result.Error.Code){job.Error="执行诊断："+result.Error.Code};break}
+ }
+ job.State="completed";if len(job.Images)>0 && len(job.Images)<job.Count{job.State="partial";if job.Error==""{job.Error="只保存了部分结果；未自动重新提交"}}
+ if len(job.Images)==0 {job.State="unconfirmed";if job.Error=="" {job.Error="未收到可确认的图片，请检查账号、额度和出口；未自动重新提交"}}
+ job.Updated=time.Now().Unix();_=writeDrawingJob(job)
+}
+
+func(h *AccountHandler) DrawingTestList(c *gin.Context){
+ if !drawingFullAdmin(c){return}
+ entries,e:=os.ReadDir(drawingJobsRoot());if e!=nil && !os.IsNotExist(e){response.Error(c,500,"无法读取测试历史");return}
+ jobs:=[]drawingTestJob{}
+ drawingJobsMu.Lock();defer drawingJobsMu.Unlock()
+ for _,entry:=range entries{if filepath.Ext(entry.Name())!=".json"{continue};id:=entry.Name()[:len(entry.Name())-5];job,e:=readDrawingJob(id);if e!=nil{continue}
+  if (job.State=="running" || job.State=="queued") && !drawingRunning[id] {job.State="unconfirmed";job.Error="服务重启前任务结果未确认，未自动重新提交";_=writeDrawingJob(job)}
+  jobs=append(jobs,job)
+ }
+ sort.Slice(jobs,func(i,j int)bool{return jobs[i].Created>jobs[j].Created})
+ response.Success(c,gin.H{"items":jobs})
+}
+func(h *AccountHandler) DrawingTestImage(c *gin.Context){
+ if !drawingFullAdmin(c){return};name:=c.Param("name")
+ if !regexp.MustCompile(`^[a-zA-Z0-9_-]{8,80}-[0-9]+\.(png|jpg|webp|gif)$`).MatchString(name){response.BadRequest(c,"图片编号无效");return}
+ c.Header("Cache-Control","private, no-store");c.Header("X-Content-Type-Options","nosniff");c.File(filepath.Join(drawingJobsRoot(),name))
+}
+func(h *AccountHandler) DrawingTestDelete(c *gin.Context){
+ if !drawingFullAdmin(c){return};id:=c.Param("id");if !drawingJobID.MatchString(id){response.BadRequest(c,"任务编号无效");return}
+ drawingJobsMu.Lock();defer drawingJobsMu.Unlock();if drawingRunning[id]{response.Error(c,409,"任务仍在执行，完成后再删除");return}
+ job,e:=readDrawingJob(id);if e!=nil{response.Error(c,404,"任务不存在");return}
+ for _,name:=range job.Images{if filepath.Base(name)==name{_=os.Remove(filepath.Join(drawingJobsRoot(),name))}}
+ if e=os.Remove(filepath.Join(drawingJobsRoot(),id+".json"));e!=nil{response.Error(c,500,"删除失败");return};response.Success(c,gin.H{"deleted":true})
+}
