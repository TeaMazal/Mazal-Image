+package service
+
+import (
+ "crypto/sha256"
+ "encoding/base64"
+ "encoding/hex"
+ "encoding/json"
+ "fmt"
+ "strings"
+)
+
+// DrawingAuthorization contains credentials only while importing. Never put it in
+// list responses, audit details, URLs, or task history.
+type DrawingAuthorization struct {
+ Source string
+ Email string
+ Fingerprint string
+ Credentials map[string]any
+}
+
+func ParseDrawingAuthorizations(raw string, sourceHint string) ([]DrawingAuthorization,error) {
+ if len(raw)>4*1024*1024 { return nil,fmt.Errorf("授权文件超过 4 MB") }
+ if sourceHint!="web" && sourceHint!="codex" && sourceHint!="auto" { return nil,fmt.Errorf("请选择 Web、Codex 或自动识别") }
+ var value any
+ if json.Unmarshal([]byte(raw),&value)!=nil {
+  raw=strings.TrimSpace(raw)
+  if raw=="" || strings.ContainsAny(raw," \r\n\t{}[]") {return nil,fmt.Errorf("授权内容不是有效 JSON 或 token")}
+  value=map[string]any{"access_token":raw}
+ }
+ if obj,ok:=value.(map[string]any);ok {if rows,exists:=obj["accounts"];exists {value=rows}}
+ rows,ok:=value.([]any);if !ok {rows=[]any{value}}
+ if len(rows)==0 || len(rows)>100 {return nil,fmt.Errorf("每批支持 1–100 个账号")}
+ result:=make([]DrawingAuthorization,0,len(rows))
+ for i,row:=range rows {
+  obj,ok:=row.(map[string]any);if !ok{return nil,fmt.Errorf("第 %d 项不是账号对象",i+1)}
+  flat:=map[string]any{}
+  for k,v:=range obj {flat[k]=v}
+  for _,key:=range []string{"credentials","tokens"} {if nested,ok:=obj[key].(map[string]any);ok {for k,v:=range nested {flat[k]=v}}}
+  str:=func(k string)string{v,_:=flat[k].(string);return strings.TrimSpace(v)}
+  token:=str("access_token");if token=="" {token=str("accessToken")}
+  if token=="" || strings.ContainsAny(token," \r\n\t") {return nil,fmt.Errorf("第 %d 项缺少有效 access_token",i+1)}
+  claims:=map[string]any{}
+  parts:=strings.Split(token,".");if len(parts)==3 {if b,e:=base64.RawURLEncoding.DecodeString(parts[1]);e==nil {_=json.Unmarshal(b,&claims)}}
+  client:=str("client_id");claimClient,_:=claims["client_id"].(string)
+  if client!="" && claimClient!="" && client!=claimClient {return nil,fmt.Errorf("第 %d 项客户端信息冲突",i+1)}
+  if claimClient!="" {client=claimClient}
+  source:=str("source_type")
+  if source!="" && source!="web" && source!="codex" {return nil,fmt.Errorf("第 %d 项账号来源不受支持",i+1)}
+  detected:=""
+  switch client {case OpenAIWebClientID:detected="web";case openAICodexClientID:detected="codex";case "":default:return nil,fmt.Errorf("第 %d 项客户端暂不支持，请核对授权文件",i+1)}
+  if detected!="" && source!="" && source!=detected {return nil,fmt.Errorf("第 %d 项账号类型与授权冲突",i+1)}
+  if detected!="" {source=detected}
+  if sourceHint!="auto" {if source!="" && source!=sourceHint {return nil,fmt.Errorf("第 %d 项与选择的账号类型不一致",i+1)};source=sourceHint}
+  if source=="" {return nil,fmt.Errorf("第 %d 项无法自动识别，请明确选择账号类型",i+1)}
+  if client=="" {if source=="web" {client=OpenAIWebClientID}else{client=openAICodexClientID}}
+  email:=str("email")
+  if profile,ok:=claims["https://api.openai.com/profile"].(map[string]any);ok && email=="" {email,_=profile["email"].(string)}
+  if email=="" {email,_=claims["email"].(string)}
+  if email=="" {parts:=strings.Split(str("id_token"),".");if len(parts)==3{if b,e:=base64.RawURLEncoding.DecodeString(parts[1]);e==nil{var identity map[string]any;if json.Unmarshal(b,&identity)==nil{email,_=identity["email"].(string)}}}}
+  email=strings.ToLower(strings.TrimSpace(email))
+  creds:=map[string]any{"access_token":token,"source_type":source,"client_id":client}
+  // Preserve reauthorization material supported by the original import format.
+  // Routing, groups and enablement are intentionally never accepted from files.
+  for _,k:=range []string{"refresh_token","id_token","expires_at","account_id","user_id","chatgpt_account_id","organization_id","web_fingerprint","password","totp_secret","session_token","cookie"} {
+   if v,ok:=flat[k];ok && v!=nil && v!="" {creds[k]=v}
+  }
+  if fp,ok:=flat["fp"].(map[string]any);ok {creds["web_fingerprint"]=fp}
+  if _,ok:=creds["expires_at"];!ok {if exp,ok:=claims["exp"].(float64);ok {creds["expires_at"]=int64(exp)}}
+  if auth,ok:=claims["https://api.openai.com/auth"].(map[string]any);ok {for _,k:=range []string{"chatgpt_account_id","chatgpt_user_id"} {if v,ok:=auth[k].(string);ok && v!="" {creds[k]=v}}}
+  if email!="" {creds["email"]=email}
+  sum:=sha256.Sum256([]byte(token));fp:=hex.EncodeToString(sum[:]);creds["drawing_import_fingerprint"]=fp
+  result=append(result,DrawingAuthorization{Source:source,Email:email,Fingerprint:fp,Credentials:creds})
+ }
+ return result,nil
+}
+
+func DrawingAuthorizationMatches(a *Account, imported DrawingAuthorization) bool {
+ if a==nil || a.Platform!=PlatformOpenAI || a.Type!=AccountTypeOAuth || a.IsCredentialShadow() {return false}
+ source:="codex";if a.IsOpenAIWeb(){source="web"}
+ if source!=imported.Source{return false}
+ if imported.Email!="" && strings.EqualFold(strings.TrimSpace(a.GetCredential("email")),imported.Email){return true}
+ sum:=sha256.Sum256([]byte(a.GetCredential("access_token")))
+ return hex.EncodeToString(sum[:])==imported.Fingerprint
+}
+
+func MergeDrawingAuthorization(existing map[string]any, imported DrawingAuthorization) map[string]any {
+ out:=make(map[string]any,len(existing)+len(imported.Credentials))
+ for k,v:=range existing {out[k]=v}
+ for k,v:=range imported.Credentials {out[k]=v}
+ // Never replace the account's model mapping or remove a refresh token merely
+ // because a newly uploaded access-token file omitted those fields.
+ return out
+}
