+"""Pure parser bridge: receives content over stdin; no network or account access."""
+import json
+import sys
+from services.proxy_subscription_parser import parse_subscription
+
+try:
+    content = sys.stdin.read(10 * 1024 * 1024 + 1)
+    if len(content) > 10 * 1024 * 1024:
+        raise ValueError('too large')
+    nodes = parse_subscription(content)
+    if len(nodes) > 5000:
+        raise ValueError('too many nodes')
+    print(json.dumps({'nodes': nodes}, ensure_ascii=True))
+except Exception:
+    print(json.dumps({'error': '订阅格式无法解析或内容超过限制'}))
+    sys.exit(1)
