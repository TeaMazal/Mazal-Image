+func(h *AccountHandler) StartDrawingMaintenance(settings *service.SettingService){
+ h.accountUsageService.ConfigureDrawingSettings(settings)
+ workerrole.Start("drawing-account-maintenance",func(){go func(){
+  ticker:=time.NewTicker(time.Minute);defer ticker.Stop()
+  last:=map[int64]time.Time{}
+  for range ticker.C{
+   ctx,cancel:=context.WithTimeout(context.Background(),10*time.Minute)
+   cfg:=drawingMaintenanceLoad(ctx,settings);if !cfg.Enabled{cancel();continue}
+   interval:=time.Duration(cfg.Interval)*time.Minute
+   var wg sync.WaitGroup;slots:=make(chan struct{},3)
+   for page:=1;ctx.Err()==nil;page++{
+    accounts,total,e:=h.adminService.ListAccounts(ctx,page,100,"openai","oauth","","",0,"","id","asc","");if e!=nil{break}
+    for _,a:=range accounts{
+     if !a.IsOpenAIWeb() || a.Status!="active" || !a.Schedulable || time.Since(last[a.ID])<interval{continue}
+     if ctx.Err()!=nil{break};slots<-struct{}{};last[a.ID]=time.Now();wg.Add(1)
+     go func(account service.Account){defer wg.Done();defer func(){<-slots}();probeCtx,done:=context.WithTimeout(ctx,100*time.Second);defer done()
+      e:=h.accountUsageService.MaintainDrawingQuota(probeCtx,&account,interval)
+      state:="ok";if e!=nil{state="unconfirmed"}
+      _=h.adminService.UpdateAccountExtra(probeCtx,account.ID,map[string]any{"drawing_maintenance":map[string]any{"checked_at":time.Now().Unix(),"state":state}})
+     }(a)
+    }
+    if len(accounts)==0 || int64(page*100)>=total{break}
+   }
+   wg.Wait();cancel()
+  }
+ }()})
+}
