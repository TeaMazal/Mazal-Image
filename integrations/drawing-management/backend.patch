+func TestDrawingSettingsPreservesHiddenSecrets(t *testing.T){
+ previous:=map[string]any{"backup":map[string]any{"secret_access_key":"key","passphrase":"phrase","bucket":"old"},"auth_token":"must-not-forward"}
+ // The handler restricts the previous values to keys actually being updated.
+ out:=mergeDrawingSecrets(map[string]any{"backup":previous["backup"]},map[string]any{"backup":map[string]any{"bucket":"new","passphrase":"","has_secret_access_key":true}})
+ backup:=out["backup"].(map[string]any)
+ if backup["passphrase"]!="phrase" || backup["secret_access_key"]!="key" || backup["bucket"]!="new" || backup["has_secret_access_key"]!=nil || out["auth_token"]!=nil{t.Fatal("secret merge lost credentials or crossed setting boundary")}
+ redacted:=redactDrawingSettings(out).(map[string]any)["backup"].(map[string]any)
+ if redacted["passphrase"]!=nil || redacted["has_passphrase"]!=true{t.Fatal("backup encryption password leaked")}
+}
