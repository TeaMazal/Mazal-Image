+
+func (h *AccountHandler) DrawingList(c *gin.Context) {
+ if !drawingFullAdmin(c){return}
+ accounts,err:=h.drawingAccounts(c);if err!=nil{response.ErrorFrom(c,err);return}
+ groups,err:=h.adminService.GetAllGroupsIncludingInactive(c.Request.Context());if err!=nil{response.ErrorFrom(c,err);return}
+ drawingGroups:=map[int64]bool{}
+ for _,g:=range groups {if g.AllowImageGeneration {drawingGroups[g.ID]=true}}
+ out:=[]gin.H{}
+ source:=c.Query("source");search:=strings.ToLower(strings.TrimSpace(c.Query("search")))
+ group,_:=strconv.ParseInt(c.Query("group_id"),10,64)
+ includeAll:=c.Query("include_all_codex")=="true"
+ for _,a:=range accounts {
+  if a.IsCredentialShadow(){continue}
+  belongs:=a.IsOpenAIWeb() || includeAll
+  hasGroup:=group==0
+  for _,g:=range a.GroupIDs {if drawingGroups[g]{belongs=true};if g==group{hasGroup=true}}
+  if !belongs || !hasGroup {continue}
+  row:=drawingAccountSummary(a)
+  if source!="" && row["source"]!=source {continue}
+  if search!="" && !strings.Contains(strings.ToLower(a.Name+" "+a.GetCredential("email")),search){continue}
+  out=append(out,row)
+ }
+ response.Success(c,gin.H{"items":out,"total":len(out)})
