+package service
+
+import (
+ "encoding/base64"
+ "testing"
+)
+
+func TestDrawingAuthorizationImportPreservesRoutingAndRefresh(t *testing.T) {
+ rows,err:=ParseDrawingAuthorizations(`{"email":"A@EXAMPLE.COM","tokens":{"access_token":"new-token"},"group_ids":[999],"proxy_id":999,"schedulable":true}`,"web")
+ if err!=nil {t.Fatal(err)}
+ if len(rows)!=1 || rows[0].Email!="a@example.com" {t.Fatal("email normalization")}
+ merged:=MergeDrawingAuthorization(map[string]any{"refresh_token":"old-refresh","model_mapping":map[string]any{"custom":"gpt-image-2"}},rows[0])
+ if merged["refresh_token"]!="old-refresh" || merged["model_mapping"]==nil || merged["access_token"]!="new-token" {t.Fatal("authorization-only merge lost configuration")}
+ for _,k:=range []string{"group_ids","proxy_id","schedulable"} {if _,ok:=merged[k];ok {t.Fatalf("imported routing field: %s",k)}}
+}
+
+func TestDrawingAuthorizationRefusesMislabeledAndAmbiguousTokens(t *testing.T) {
+ token:="x."+base64.RawURLEncoding.EncodeToString([]byte(`{"client_id":"`+openAICodexClientID+`"}`))+".x"
+ if _,err:=ParseDrawingAuthorizations(token,"web");err==nil {t.Fatal("accepted Codex as Web")}
+ if _,err:=ParseDrawingAuthorizations("opaque-token","auto");err==nil {t.Fatal("guessed opaque token type")}
+ rows,err:=ParseDrawingAuthorizations(token,"auto");if err!=nil || rows[0].Source!="codex" {t.Fatal("Codex auto recognition",err)}
+}
