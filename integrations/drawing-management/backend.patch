+  session.Pending=&rows[0]
+ }
+ row:=*session.Pending
+ drawingImportMu.Lock();defer drawingImportMu.Unlock()
+ accounts,e:=h.drawingAccounts(c);if e!=nil{response.Error(c,503,"账号列表暂不可读，授权暂存，可重试保存");return}
+ var existing *service.Account
+ for i:=range accounts {
+  if session.AccountID!=0 {if accounts[i].ID==session.AccountID{existing=&accounts[i]};continue}
+  if service.DrawingAuthorizationMatches(&accounts[i],row){if existing!=nil{response.Error(c,409,"存在多个匹配账号，请先核对");return};existing=&accounts[i]}
+ }
+ if session.AccountID!=0 && (existing==nil || !service.DrawingAuthorizationMatches(existing,row)){response.BadRequest(c,"登录的账号与待更新账号不一致，未覆盖原授权");return}
+ var saved *service.Account
+ if existing!=nil{saved,e=h.adminService.UpdateAccount(c.Request.Context(),existing.ID,&service.UpdateAccountInput{Credentials:service.MergeDrawingAuthorization(existing.Credentials,row)})}else{
+  name:=row.Email;if name==""{name=row.Fingerprint[:12]}
+  if row.Source=="web"{row.Credentials["model_mapping"]=map[string]any{"gpt-image-2":"gpt-image-2"}}
+  saved,e=h.adminService.CreateAccount(c.Request.Context(),&service.CreateAccountInput{Name:"["+row.Source+"] "+name,Platform:service.PlatformOpenAI,Type:service.AccountTypeOAuth,Credentials:row.Credentials,GroupIDs:session.GroupIDs,ProxyID:session.ProxyID,Concurrency:3,Priority:50,SkipDefaultGroupBind:true,StartInactive:true})
+ }
+ if e!=nil{response.Error(c,503,"授权已取得，保存结果待核对；可在本会话重试保存");return}
+ session.SavedID=saved.ID;session.Pending=nil;session.Verifier="";session.ProxyURL=""
+ response.Success(c,gin.H{"id":saved.ID,"saved":true})
+}
