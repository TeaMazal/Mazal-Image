+const drawingQuotaCooldownReason="drawing_web_quota_exhausted"
+
+func(s *AccountUsageService) ConfigureDrawingSettings(settings *SettingService){s.drawingSettings=settings}
+
+// MaintainDrawingQuota never changes the manual scheduling switch or overwrites
+// an unrelated cooldown. A successful fresh quota response alone may clear ours.
+func(s *AccountUsageService) MaintainDrawingQuota(ctx context.Context,account *Account,interval time.Duration)error{
+ if account==nil || !account.IsOpenAIWeb() || account.Status!=StatusActive || !account.Schedulable{return nil}
+ usage,e:=s.GetUsageForAccount(ctx,account,true);if e!=nil{return e}
+ if usage==nil || usage.Error!="" || usage.WebImageUsage==nil || usage.WebImageUsage.Remaining==nil{return fmt.Errorf("未取得可靠额度快照，保留原调度状态")}
+ fresh,e:=s.accountRepo.GetByID(ctx,account.ID);if e!=nil{return e}
+ if fresh.Status!=StatusActive || !fresh.Schedulable{return nil}
+ if !reflect.DeepEqual(account.Credentials,fresh.Credentials) || !reflect.DeepEqual(account.ProxyID,fresh.ProxyID){return nil}
+ if fresh.TempUnschedulableReason!="" && fresh.TempUnschedulableReason!=drawingQuotaCooldownReason{return nil}
+ writer,ok:=s.accountRepo.(interface{SetDrawingQuotaCooldownIfUnchanged(context.Context,int64,time.Time,*time.Time)error})
+ if !ok{return fmt.Errorf("额度维护存储不支持并发保护，未修改调度状态")}
+ if *usage.WebImageUsage.Remaining<=0{
+  until:=time.Now().Add(2*interval);return writer.SetDrawingQuotaCooldownIfUnchanged(ctx,account.ID,fresh.UpdatedAt,&until)
+ }
+ if fresh.TempUnschedulableReason==drawingQuotaCooldownReason{return writer.SetDrawingQuotaCooldownIfUnchanged(ctx,account.ID,fresh.UpdatedAt,nil)}
+ return nil
+}
