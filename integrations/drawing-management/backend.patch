+package service
+
+import (
+ "fmt"
+ "time"
+)
+
+// DrawingProxyURL is fail-closed: a missing/disabled assigned proxy is not an
+// instruction to connect directly. Explicitly unassigned accounts may use direct.
+func DrawingProxyURL(account *Account) (string,error) {
+ if account==nil{return "",fmt.Errorf("drawing account unavailable")}
+ if account.ProxyID==nil {return "",nil}
+ p:=account.Proxy
+ if p==nil || p.ID!=*account.ProxyID {return "",fmt.Errorf("assigned drawing proxy unavailable; direct fallback refused")}
+ if !p.IsActive() || p.IsExpired(time.Now()) {return "",fmt.Errorf("assigned drawing proxy disabled or expired; direct fallback refused")}
+ if p.Host=="" || p.Port<1 || p.Port>65535 {return "",fmt.Errorf("assigned drawing proxy configuration invalid")}
+ switch p.Protocol {case "http","https","socks5","socks5h":default:return "",fmt.Errorf("assigned drawing proxy protocol unsupported")}
+ return p.URL(),nil
+}
