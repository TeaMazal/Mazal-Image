-	}
-	info.FiveHour.WindowStats = &WindowStats{
-		Requests:     int64(parseExtraInt(raw["requests"])),
-		Tokens:       int64(parseExtraInt(raw["tokens"])),
-		Cost:         parseExtraFloat64(raw["cost"]),
-		StandardCost: parseExtraFloat64(raw["standard_cost"]),
