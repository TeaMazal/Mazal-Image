+  cfg.Subscriptions=append(cfg.Subscriptions,DrawingProxySubscription{ID:id,URL:address,Nodes:[]DrawingProxyNode{}});index=len(cfg.Subscriptions)-1
+ }
+ s:=&cfg.Subscriptions[index];s.Name=strings.TrimSpace(name);s.Enabled=enabled;s.RefreshHours=hours;s.UserAgent=userAgent;if address!=""{s.URL=address}
+ return id,m.save(ctx,cfg)
+}
+
+func parseDrawingNodes(ctx context.Context,content string)([]DrawingProxyNode,error) {
+ if len(content)>10*1024*1024{return nil,fmt.Errorf("订阅超过 10 MB")}
+ python,worker:=webWorkerPaths();ctx,cancel:=context.WithTimeout(ctx,20*time.Second);defer cancel()
+ cmd:=exec.CommandContext(ctx,python,"-B",filepath.Join(filepath.Dir(worker),"parse_drawing_subscription.py"));cmd.Stdin=strings.NewReader(content);cmd.Stderr=io.Discard
+ out,err:=cmd.Output();if err!=nil || len(out)>20*1024*1024{return nil,fmt.Errorf("订阅无法解析，请检查格式")}
+ var parsed struct{Nodes []DrawingProxyNode `json:"nodes"`};if json.Unmarshal(out,&parsed)!=nil{return nil,fmt.Errorf("订阅解析结果无效")}
+ // Stable endpoint identity survives password changes; duplicate endpoint names
+ // are disambiguated instead of overwriting one another.
+ seen:=map[string]int{}
+ for i:=range parsed.Nodes {n:=&parsed.Nodes[i];identity:=fmt.Sprintf("%s|%v|%v|%v",n.Mode,n.Proxy["type"],n.Proxy["server"],n.Proxy["port"])
+  if n.Mode=="direct" {u,e:=url.Parse(n.URL);if e!=nil{return nil,fmt.Errorf("节点地址无效")};username:="";if u.User!=nil{username=u.User.Username()};identity=u.Scheme+"|"+u.Host+"|"+username}
+  identity+="|"+n.Name;seen[identity]++;sum:=sha256.Sum256([]byte(fmt.Sprintf("%s|%d",identity,seen[identity])));n.Key=hex.EncodeToString(sum[:16])
+ }
+ return parsed.Nodes,nil
+}
+
+func(m *DrawingProxyManager) Refresh(ctx context.Context,id,content string)error {
+ m.mu.Lock();defer m.mu.Unlock();cfg,err:=m.load(ctx);if err!=nil{return err}
+ index:=-1;for i:=range cfg.Subscriptions{if cfg.Subscriptions[i].ID==id{index=i}}
+ if id=="manual" && index<0{cfg.Subscriptions=append(cfg.Subscriptions,DrawingProxySubscription{ID:id,Name:"手动导入",Nodes:[]DrawingProxyNode{}});index=len(cfg.Subscriptions)-1}
+ if index<0{return fmt.Errorf("订阅不存在")};s:=&cfg.Subscriptions[index];s.LastAttempt=time.Now().Unix()
+ fail:=func(message string)error{s.Error=message;_ = m.save(ctx,cfg);return fmt.Errorf("%s",message)}
+ if id!="manual" {
+  req,e:=http.NewRequestWithContext(ctx,"GET",s.URL,nil);if e!=nil{return fail("订阅地址无效")}
+  ua:=s.UserAgent;if ua==""{ua="clash.meta"};req.Header.Set("User-Agent",ua)
+  client:=&http.Client{Timeout:30*time.Second}
+  res,e:=client.Do(req);if e!=nil{return fail("订阅下载失败，现有节点保持不变")};defer res.Body.Close()
+  if res.StatusCode!=200{return fail(fmt.Sprintf("订阅返回 HTTP %d，现有节点保持不变",res.StatusCode))}
+  b,e:=io.ReadAll(io.LimitReader(res.Body,10*1024*1024+1));if e!=nil || len(b)>10*1024*1024{return fail("订阅读取失败或超过限制")};content=string(b)
+ }
+ nodes,e:=parseDrawingNodes(ctx,content);if e!=nil{return fail(e.Error())}
+ old:=map[string]DrawingProxyNode{};for _,n:=range s.Nodes{old[n.Key]=n}
+ if id=="manual" {nodes=append(s.Nodes,nodes...)}
+ seen:=map[string]bool{};merged:=[]DrawingProxyNode{}
+ for _,n:=range nodes {
+  if seen[n.Key]{continue};seen[n.Key]=true
+  if prev,ok:=old[n.Key];ok {n.ProxyID=prev.ProxyID;n.CorePort=prev.CorePort;n.DisabledVersion=prev.DisabledVersion}
+  merged=append(merged,n)
+ }
+ for _,n:=range s.Nodes {if !seen[n.Key] && n.ProxyID!=0 {n.Missing=true;merged=append(merged,n)}}
+ s.Nodes=merged;s.Error="";s.LastSuccess=time.Now().Unix()
+ // Commit subscription metadata before applying external changes. A failed apply
+ // remains visible and can be retried without creating a second proxy identity.
+ if e=m.save(ctx,cfg);e!=nil{return e}
+ for i:=range s.Nodes {
+  n:=&s.Nodes[i]
+  if n.ProxyID==0{continue}
+  p,lookupErr:=m.admin.GetProxy(ctx,n.ProxyID);if lookupErr!=nil{return fmt.Errorf("订阅节点对应的主站代理不可用，请核对绑定")}
+  if n.Missing || n.Mode=="unsupported" {
+   if p.IsActive(){p,e=m.admin.UpdateProxy(ctx,n.ProxyID,&UpdateProxyInput{Status:"inactive",ExpectedVersion:drawingProxyVersion(p)});if e==nil{n.DisabledVersion=drawingProxyVersion(p)}}
+  }else{
+   // Only undo our own disable. A later manual change always takes precedence.
+   restore:=drawingCanRestoreProxy(p,n.DisabledVersion)
+   if n.Mode=="direct" {e=m.updateDirect(ctx,*n,drawingProxyVersion(p),restore)}else if restore {_,e=m.admin.UpdateProxy(ctx,n.ProxyID,&UpdateProxyInput{Status:StatusActive,ExpectedVersion:drawingProxyVersion(p)})}
+   n.DisabledVersion=""
+  }
+  if e!=nil{return fmt.Errorf("订阅已保存，但部分节点更新失败，请核对后重试")}
+ }
+ if e=m.save(ctx,cfg);e!=nil{return e}
+ hasCore:=false;for _,n:=range s.Nodes{if n.CorePort!=0{hasCore=true}}
+ if hasCore {return m.applyCore(ctx,&cfg)}
