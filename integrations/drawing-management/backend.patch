+  session.State=drawingRandom();session.Verifier=drawingRandom();session.Redirect="https://platform.openai.com/auth/callback"
+  sum:=sha256.Sum256([]byte(session.Verifier))
+  values:=url.Values{"issuer":{"https://auth.openai.com"},"client_id":{service.OpenAIWebClientID},"audience":{"https://api.openai.com/v1"},"redirect_uri":{session.Redirect},"device_id":{drawingRandom()},"screen_hint":{"login_or_signup"},"max_age":{"0"},"scope":{"openid profile email offline_access"},"response_type":{"code"},"response_mode":{"query"},"state":{session.State},"nonce":{drawingRandom()},"code_challenge":{base64.RawURLEncoding.EncodeToString(sum[:])},"code_challenge_method":{"S256"},"auth0Client":{"eyJuYW1lIjoiYXV0aDAtc3BhLWpzIiwidmVyc2lvbiI6IjEuMjEuMCJ9"}}
