+++ b/internal/repository/drawing_maintenance.go
@@ -0,0 +1,25 @@
+package repository
+
+import (
+ "context"
+ "time"
+ "github.com/Wei-Shaw/sub2api/internal/service"
+)
+
+// The version predicate prevents quota maintenance from clearing a newer manual
+// or automatic quarantine. Mutation and scheduler event commit in one statement.
+func(r *accountRepository) SetDrawingQuotaCooldownIfUnchanged(ctx context.Context,id int64,version time.Time,until *time.Time)error{
+ _,err:=r.sql.ExecContext(ctx,`
+ WITH changed AS (
+ UPDATE accounts SET temp_unschedulable_until=$1,
+ temp_unschedulable_reason=CASE WHEN $1::timestamptz IS NULL THEN NULL ELSE 'drawing_web_quota_exhausted' END,
+ updated_at=NOW()
+ WHERE id=$2 AND updated_at=$3 AND deleted_at IS NULL
+ AND status='active' AND schedulable IS TRUE
+ AND COALESCE(temp_unschedulable_reason,'') IN ('','drawing_web_quota_exhausted')
+ RETURNING id)
+ INSERT INTO scheduler_outbox(event_type,account_id,group_id,payload)
+ SELECT $4,id,NULL,NULL FROM changed`,until,id,version,service.SchedulerOutboxEventAccountChanged)
+ if err==nil{r.syncSchedulerAccountSnapshotDetached(ctx,id)}
+ return err
+}
