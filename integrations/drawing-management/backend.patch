+func(h *AccountHandler) DrawingOAuthStart(c *gin.Context){
+ if !drawingFullAdmin(c){return}
+ var req struct{Source string `json:"source"`;AccountID int64 `json:"account_id"`;GroupIDs []int64 `json:"group_ids"`;ProxyID *int64 `json:"proxy_id"`}
+ c.Request.Body=http.MaxBytesReader(c.Writer,c.Request.Body,16384)
+ if c.ShouldBindJSON(&req)!=nil || (req.Source!="web" && req.Source!="codex"){response.BadRequest(c,"请选择 Web 或 Codex 授权");return}
+ if req.AccountID!=0 {
+  account,e:=h.adminService.GetAccount(c.Request.Context(),req.AccountID)
+  if e!=nil || account.Platform!="openai" || account.Type!="oauth" || account.IsCredentialShadow(){response.BadRequest(c,"账号不可用于重新授权");return}
+  if account.IsOpenAIWeb()!=(req.Source=="web"){response.BadRequest(c,"授权类型与原账号不一致");return}
+  req.ProxyID=account.ProxyID;req.GroupIDs=account.GroupIDs
