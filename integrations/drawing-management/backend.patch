+ if cfg.PollTimeout<30 || cfg.PollTimeout>1200 || cfg.PollInterval<1 || cfg.PollInterval>60 || cfg.InitialWait<0 || cfg.InitialWait>120 || len(cfg.SystemPrompt)>8000 || len(cfg.SolverKey)>4096{return fmt.Errorf("执行参数超出支持范围")}
