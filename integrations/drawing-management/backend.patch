+
+// Only retained management features are bridged. Account pools, local API keys,
+// remote account import and generation endpoints can never use this credential.
+func drawingEngineAllowed(method,path string)bool {
+ if strings.Contains(path,"..") || strings.ContainsAny(path,"\\\x00") {return false}
+ exact:=map[string]string{
+  "/api/admin/template-library":"GET", "/api/admin/template-library/cover":"POST",
+  "/api/images":"GET", "/api/images/delete":"POST", "/api/images/download":"POST",
+  "/api/images/protection":"POST",
+  "/api/images/tags":"GET POST", "/api/images/storage":"GET", "/api/images/storage/compress":"POST", "/api/images/storage/cleanup-to-target":"POST",
+  "/api/storage/info":"GET", "/api/image-storage/test":"POST", "/api/image-storage/sync":"POST",
+  "/api/logs":"GET", "/api/logs/delete":"POST",
+  "/api/backups":"GET", "/api/backups/run":"POST", "/api/backups/delete":"POST", "/api/backups/detail":"GET", "/api/backups/download":"GET", "/api/backup/test":"POST",
+  "/api/settings":"GET POST", "/api/third-party-apps":"GET",
+ }
+ if methods,ok:=exact[path];ok {for _,allowed:=range strings.Fields(methods){if allowed==method{return true}};return false}
+ if method=="PUT" && strings.HasPrefix(path,"/api/admin/template-library/"){return true}
+ if method=="DELETE" && strings.HasPrefix(path,"/api/images/tags/"){return true}
+ if method=="GET" {for _,prefix:=range []string{"/images/","/image-thumbnails/","/api/images/download/","/template-media/"}{if strings.HasPrefix(path,prefix){return true}}}
+ return false
+}
+
+var drawingSettingKeys=map[string]bool{"image_retention_days":true,"image_poll_timeout_secs":true,"image_poll_interval_secs":true,"image_poll_initial_wait_secs":true,"image_remove_conversation_after_result":true,"image_remove_conversation_always":true,"backup":true,"image_storage":true,"log_levels":true,"third_party_apps":true}
+
+func mergeDrawingSecrets(previous,input map[string]any)map[string]any {
+ out:=map[string]any{}
+ for k,v:=range input {if strings.HasPrefix(k,"has_"){continue};out[k]=v}
+ for k,v:=range previous {
+  lower:=strings.ToLower(k)
+  if drawingSecretKey(lower) {if current,ok:=out[k];!ok || current==""{out[k]=v};continue}
+  old,ok:=v.(map[string]any);next,exists:=out[k].(map[string]any);if ok && exists{out[k]=mergeDrawingSecrets(old,next)}
+ }
+ return out
+}
+
+func drawingSecretKey(key string)bool {
+ lower:=strings.ToLower(key)
+ return strings.Contains(lower,"password") || strings.Contains(lower,"secret") || strings.Contains(lower,"access_key") || strings.Contains(lower,"token") || strings.Contains(lower,"passphrase")
+}
+
+func redactDrawingSettings(value any)any {
+ switch v:=value.(type){
+ case map[string]any:
+  out:=map[string]any{}
+  for key,item:=range v {if drawingSecretKey(key) {out["has_"+key]=item!=nil && item!="";continue};out[key]=redactDrawingSettings(item)}
+  return out
+ case []any:out:=make([]any,len(v));for i,item:=range v{out[i]=redactDrawingSettings(item)};return out
+ default:return value
+ }
+}
+
+func DrawingEngine(c *gin.Context) {
+ if !drawingFullAdmin(c){return}
+ path:=c.Param("path")
+ if !drawingEngineAllowed(c.Request.Method,path){response.Error(c,404,"此功能不属于绘图管理接口");return}
+ origin:=strings.TrimRight(os.Getenv("SUB2API_DRAWING_MANAGEMENT_ORIGIN"),"/")
+ key:=os.Getenv("SUB2API_DRAWING_MANAGEMENT_KEY")
+ base,e:=url.Parse(origin);if e!=nil || base.Host=="" || key==""{response.Error(c,503,"绘图管理服务尚未连接");return}
+ body,e:=io.ReadAll(io.LimitReader(c.Request.Body,12*1024*1024+1));if e!=nil || len(body)>12*1024*1024{response.Error(c,413,"请求内容过大");return}
+ if path=="/api/settings" && c.Request.Method=="POST" {
+  var input map[string]any;if json.Unmarshal(body,&input)!=nil{response.BadRequest(c,"设置格式无效");return}
+  for k:=range input{if !drawingSettingKeys[k]{response.BadRequest(c,"此设置请使用主站对应管理入口");return}}
+  get,_:=http.NewRequestWithContext(c.Request.Context(),"GET",origin+"/api/settings",nil);get.Header.Set("Authorization","Bearer "+key)
+  previousRes,err:=(&http.Client{Timeout:20*time.Second,CheckRedirect:func(_ *http.Request,_ []*http.Request)error{return http.ErrUseLastResponse}}).Do(get)
+  if err!=nil{response.Error(c,502,"无法核对原设置，未保存修改");return}
+  var previous struct{Config map[string]any `json:"config"`};decodeErr:=json.NewDecoder(io.LimitReader(previousRes.Body,2*1024*1024)).Decode(&previous);previousRes.Body.Close()
+  if previousRes.StatusCode!=200 || decodeErr!=nil{response.Error(c,502,"无法读取原设置，未保存修改");return}
+  allowedPrevious:=map[string]any{}
+  for k:=range input {allowedPrevious[k]=previous.Config[k]}
+  body,_=json.Marshal(mergeDrawingSecrets(allowedPrevious,input))
+ }
+ target:=origin+path;if c.Request.URL.RawQuery!=""{target+="?"+c.Request.URL.RawQuery}
+ req,e:=http.NewRequestWithContext(c.Request.Context(),c.Request.Method,target,bytes.NewReader(body));if e!=nil{response.BadRequest(c,"管理请求无效");return}
+ req.Header.Set("Authorization","Bearer "+key);req.Header.Set("Content-Type",c.GetHeader("Content-Type"))
+ req.Header.Set("X-Souhub-Management-Bridge",os.Getenv("SUB2API_DRAWING_MANAGEMENT_BRIDGE_KEY"))
+ client:=&http.Client{Timeout:5*time.Minute,CheckRedirect:func(_ *http.Request,_ []*http.Request)error{return http.ErrUseLastResponse}}
+ res,e:=client.Do(req);if e!=nil{response.Error(c,502,"绘图管理服务连接失败");return};defer res.Body.Close()
+ c.Header("Cache-Control","no-store");c.Header("X-Content-Type-Options","nosniff")
+ if res.StatusCode>=300 && res.StatusCode<400 {response.Error(c,502,"绘图管理服务返回了非预期跳转");return}
+ if path=="/api/settings" && res.StatusCode==200 {
+  var data struct{Config map[string]any `json:"config"`};if json.NewDecoder(io.LimitReader(res.Body,2*1024*1024)).Decode(&data)!=nil{response.Error(c,502,"设置读取失败");return}
+  allowed:=map[string]any{};for k,v:=range data.Config{if drawingSettingKeys[k]{allowed[k]=v}}
+  c.JSON(200,gin.H{"config":redactDrawingSettings(allowed)});return
+ }
+ if disposition:=res.Header.Get("Content-Disposition");disposition!=""{c.Header("Content-Disposition",disposition)}
+ c.Status(res.StatusCode);c.Header("Content-Type",res.Header.Get("Content-Type"));_,_=io.Copy(c.Writer,res.Body)
+}
