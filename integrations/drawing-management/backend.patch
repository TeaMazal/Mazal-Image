+func(m *DrawingProxyManager) RemoveNodes(ctx context.Context,id string,keys []string)error {
+ m.mu.Lock();defer m.mu.Unlock();cfg,e:=m.load(ctx);if e!=nil{return e}
+ wanted:=map[string]bool{};for _,key:=range keys{wanted[key]=true}
+ for i:=range cfg.Subscriptions {
+  if cfg.Subscriptions[i].ID!=id{continue}
+  for index:=0;index<len(cfg.Subscriptions[i].Nodes); {
+   n:=cfg.Subscriptions[i].Nodes[index]
+   if !wanted[n.Key]{index++;continue}
+   if n.ProxyID!=0 {
+    shared:=false;for j,s:=range cfg.Subscriptions{for k,other:=range s.Nodes{if i==j && index==k{continue};if other.ProxyID==n.ProxyID{shared=true}}}
+    if !shared {
+     _,lookupErr:=m.admin.GetProxy(ctx,n.ProxyID)
+     if lookupErr!=nil && !errors.Is(lookupErr,ErrProxyNotFound){return fmt.Errorf("无法核对节点状态")}
+     if lookupErr==nil {
+      accounts,e:=m.admin.GetProxyAccounts(ctx,n.ProxyID);if e!=nil{return fmt.Errorf("无法核对节点绑定")};if len(accounts)>0{return fmt.Errorf("节点仍绑定账号，请先调整账号出口；此前已移除的节点已保存")}
+      if e=m.admin.DeleteProxy(ctx,n.ProxyID);e!=nil && !errors.Is(e,ErrProxyNotFound){return fmt.Errorf("删除主站代理失败，请刷新核对")}
+     }
+     ids:=[]int64{};for _,managed:=range cfg.ManagedIDs{if managed!=n.ProxyID{ids=append(ids,managed)}};cfg.ManagedIDs=ids;delete(cfg.Health,n.ProxyID)
