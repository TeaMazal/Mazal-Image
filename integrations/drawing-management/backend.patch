+}
+
+func directProxyInput(n DrawingProxyNode)(*CreateProxyInput,error) {
+ u,e:=url.Parse(n.URL);if e!=nil{return nil,fmt.Errorf("节点地址无效")};port,e:=strconv.Atoi(u.Port());if e!=nil || port<1 || port>65535 || u.Hostname()==""{return nil,fmt.Errorf("节点端口无效")}
+ switch u.Scheme{case "http","https","socks5","socks5h":default:return nil,fmt.Errorf("节点协议无效")}
+ input:=&CreateProxyInput{Name:n.Name,Protocol:u.Scheme,Host:u.Hostname(),Port:port,FallbackMode:FallbackModeNone}
+ if u.User!=nil{input.Username=u.User.Username();input.Password,_=u.User.Password()};return input,nil
+}
+func(m *DrawingProxyManager) updateDirect(ctx context.Context,n DrawingProxyNode,version string,restore bool)error {
+ p,e:=directProxyInput(n);if e!=nil{return e}
+ status:="";if restore{status=StatusActive}
+ _,e=m.admin.UpdateProxy(ctx,n.ProxyID,&UpdateProxyInput{Name:p.Name,Protocol:p.Protocol,Host:p.Host,Port:p.Port,Username:&p.Username,Password:&p.Password,Status:status,ExpectedVersion:version});return e
+}
+
+func(m *DrawingProxyManager) Import(ctx context.Context,id string,keys []string)error {
+ if len(keys)==0 || len(keys)>1000{return fmt.Errorf("每批请选择 1–1000 个节点")}
+ m.mu.Lock();defer m.mu.Unlock();cfg,e:=m.load(ctx);if e!=nil{return e}
+ selected:=map[string]bool{};for _,k:=range keys{selected[k]=true}
+ index:=-1;for i:=range cfg.Subscriptions{if cfg.Subscriptions[i].ID==id{index=i}};if index<0{return fmt.Errorf("订阅不存在")}
+ used:=map[int]bool{};for _,s:=range cfg.Subscriptions{for _,n:=range s.Nodes{if n.CorePort!=0{used[n.CorePort]=true}}}
+ nodes:=cfg.Subscriptions[index].Nodes
+ for i:=range nodes {
+  n:=&nodes[i];if !selected[n.Key] || n.ProxyID!=0{continue}
+  if n.Missing || n.Mode=="unsupported"{return fmt.Errorf("选择中包含不可用节点")}
+  var input *CreateProxyInput
+  if n.Mode=="direct" {input,e=directProxyInput(*n);if e!=nil{return e}}else{
+   if !cfg.Core.Enabled{return fmt.Errorf("此节点需要先配置并启用代理核心")}
+   port:=cfg.Core.PortStart;for used[port]{port++};if port>64000{return fmt.Errorf("核心监听端口不足")};used[port]=true;n.CorePort=port
+   input=&CreateProxyInput{Name:n.Name,Protocol:"http",Host:cfg.Core.ListenHost,Port:port,FallbackMode:FallbackModeNone}
+  }
+  existing,e:=m.findProxy(ctx,input);if e!=nil{return e}
+  if existing!=nil{n.ProxyID=existing.ID}else{p,e:=m.admin.CreateProxy(ctx,input);if e!=nil{return fmt.Errorf("创建节点失败，请刷新核对")};n.ProxyID=p.ID}
+  found:=false;for _,v:=range cfg.ManagedIDs{if v==n.ProxyID{found=true}};if !found{cfg.ManagedIDs=append(cfg.ManagedIDs,n.ProxyID)}
+  cfg.Subscriptions[index].Nodes=nodes
