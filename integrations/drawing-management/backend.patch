+   }
+   cfg.Subscriptions[i].Nodes=append(cfg.Subscriptions[i].Nodes[:index],cfg.Subscriptions[i].Nodes[index+1:]...)
+   if e=m.save(ctx,cfg);e!=nil{return fmt.Errorf("节点删除结果待核对，刷新后可重试；不会删除其他节点")}
+  }
+  if cfg.Core.Enabled{return m.applyCore(ctx,&cfg)};return nil
+ }
+ return fmt.Errorf("订阅不存在")
+}
