+func(h *DrawingProxyHandler) Get(c *gin.Context){if !drawingFullAdmin(c){return};data,e:=h.manager.Public(c.Request.Context());if e!=nil{response.Error(c,500,"读取绘图代理配置失败");return};response.Success(c,data)}
+func(h *DrawingProxyHandler) Mutate(c *gin.Context) {
+ if !drawingFullAdmin(c){return}
+ c.Request.Body=http.MaxBytesReader(c.Writer,c.Request.Body,12*1024*1024)
+ var req struct {
+  Action string `json:"action"`
+  ID string `json:"id"`
+  Name string `json:"name"`
+  URL string `json:"url"`
+  UserAgent string `json:"user_agent"`
+  Enabled bool `json:"enabled"`
+  Hours int `json:"refresh_hours"`
+  Content string `json:"content"`
+  Keys []string `json:"keys"`
+  Core service.DrawingProxyCore `json:"core"`
+  Interval int `json:"probe_interval"`
+  Failure int `json:"failure_threshold"`
+  Recovery int `json:"recovery_successes"`
+  IDs []int64 `json:"managed_ids"`
+ }
+ if c.ShouldBindJSON(&req)!=nil{response.BadRequest(c,"代理管理参数无效");return}
+ var err error
+ ctx:=c.Request.Context()
+ switch req.Action {
+ case "save_subscription":_,err=h.manager.SaveSubscription(ctx,req.ID,req.Name,req.URL,req.UserAgent,req.Enabled,req.Hours)
+ case "refresh":err=h.manager.Refresh(ctx,req.ID,"")
+ case "parse_manual":err=h.manager.Refresh(ctx,"manual",req.Content)
+ case "import":err=h.manager.Import(ctx,req.ID,req.Keys)
+ case "remove_subscription":err=h.manager.RemoveSubscription(ctx,req.ID)
+ case "remove_nodes":err=h.manager.RemoveNodes(ctx,req.ID,req.Keys)
+ case "save_core":err=h.manager.SaveCore(ctx,req.Core)
+ case "apply_core":err=h.manager.ApplyCore(ctx)
+ case "save_health":err=h.manager.SaveHealth(ctx,req.Enabled,req.Interval,req.Failure,req.Recovery,req.IDs)
+ default:response.BadRequest(c,"不支持的代理管理操作");return
+ }
+ if err!=nil{response.BadRequest(c,err.Error());return}
+ h.Get(c)
