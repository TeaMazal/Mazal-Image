+ cfg:=DrawingProxyConfig{Core:DrawingProxyCore{APIURL:"http://souhub-drawing-proxy-core-r28:9090",ListenHost:"souhub-drawing-proxy-core-r28",PortStart:20000},ProbeInterval:300,FailureThreshold:3,RecoverySuccesses:2,Health:map[int64]DrawingProxyHealth{},ManagedIDs:[]int64{},Subscriptions:[]DrawingProxySubscription{}}
