+package service
+
+import (
+ "context"
+ "testing"
+ "time"
+)
+
+type drawingProxyVersionRepo struct {ProxyRepository;proxy *Proxy;writes int}
+func(r *drawingProxyVersionRepo)GetByID(_ context.Context,_ int64)(*Proxy,error){copy:=*r.proxy;return &copy,nil}
+func(r *drawingProxyVersionRepo)Update(_ context.Context,p *Proxy)error{copy:=*p;copy.UpdatedAt=time.Now();r.proxy=&copy;r.writes++;return nil}
+
+func TestDrawingProxyAutomaticUpdateDoesNotOverwriteManualChange(t *testing.T){
+ repo:=&drawingProxyVersionRepo{proxy:&Proxy{ID:7,Status:"inactive",Host:"proxy",Port:80,UpdatedAt:time.Now()}}
+ stale:=drawingProxyVersion(repo.proxy);repo.proxy.UpdatedAt=repo.proxy.UpdatedAt.Add(time.Second)
+ admin:=&adminServiceImpl{proxyRepo:repo}
+ if _,e:=admin.UpdateProxy(context.Background(),7,&UpdateProxyInput{Status:StatusActive,ExpectedVersion:stale});e==nil{t.Fatal("stale automatic recovery overwrote manual edit")}
+ if repo.writes!=0 || repo.proxy.Status!="inactive"{t.Fatal("failed version check still wrote state")}
+ fresh:=drawingProxyVersion(repo.proxy)
+ updated,e:=admin.UpdateProxy(context.Background(),7,&UpdateProxyInput{Status:StatusActive,ExpectedVersion:fresh})
+ if e!=nil || repo.writes!=1 || updated.Status!=StatusActive || drawingProxyVersion(updated)!=drawingProxyVersion(repo.proxy){t.Fatal("automatic update lacks committed version",e)}
+}
+
+func TestDrawingProxyNeverSilentlyFallsBackToDirect(t *testing.T) {
+ id:=int64(7)
+ expired:=time.Now().Add(-time.Hour)
+ for _,proxy:=range []*Proxy{nil,{ID:8,Status:StatusActive,Host:"proxy",Port:80,Protocol:"http"},{ID:7,Status:"inactive",Host:"proxy",Port:80,Protocol:"http"},{ID:7,Status:StatusActive,ExpiresAt:&expired,Host:"proxy",Port:80,Protocol:"http"}} {
+  if _,err:=DrawingProxyURL(&Account{ProxyID:&id,Proxy:proxy});err==nil {t.Fatal("accepted unavailable assigned proxy")}
+ }
+ if got,err:=DrawingProxyURL(&Account{});err!=nil || got!="" {t.Fatal("explicit direct not allowed")}
+ got,err:=DrawingProxyURL(&Account{ProxyID:&id,Proxy:&Proxy{ID:7,Status:StatusActive,Host:"proxy",Port:8080,Protocol:"http"}})
+ if err!=nil || got!="http://proxy:8080" {t.Fatal("valid proxy not used",err)}
+}
+
+func TestDrawingProxyRecoveryRespectsManualEdits(t *testing.T){
+ p:=&Proxy{ID:7,Status:"inactive",Host:"proxy",Port:80,UpdatedAt:time.Now()}
+ version:=drawingProxyVersion(p)
+ if !drawingCanRestoreProxy(p,version){t.Fatal("automatic disable cannot recover")}
+ p.UpdatedAt=p.UpdatedAt.Add(time.Second)
+ if drawingCanRestoreProxy(p,version){t.Fatal("manual disable overridden")}
+ if drawingCanRestoreProxy(p,""){t.Fatal("unknown ownership may not restore")}
+ p.UpdatedAt=p.UpdatedAt.Add(-time.Second);expired:=time.Now().Add(-time.Hour);p.ExpiresAt=&expired
+ if drawingCanRestoreProxy(p,drawingProxyVersion(p)){t.Fatal("expired proxy restored")}
+}
