+func drawingMaintenanceLoad(ctx context.Context,settings *service.SettingService)drawingMaintenanceConfig{
+ cfg:=drawingMaintenanceConfig{Enabled:false,Interval:15};raw,e:=settings.GetCustomSetting(ctx,drawingMaintenanceKey)
+ if e==nil && raw!=""{if json.Unmarshal([]byte(raw),&cfg)!=nil{return drawingMaintenanceConfig{Interval:15}}}
+ if cfg.Interval<5 || cfg.Interval>1440{return drawingMaintenanceConfig{Interval:15}}
+ return cfg
+}
+
+func(h *AccountHandler) DrawingMaintenance(settings *service.SettingService)gin.HandlerFunc{
+ return func(c *gin.Context){
+  if !drawingFullAdmin(c){return}
+  if c.Request.Method=="POST"{
+   var cfg drawingMaintenanceConfig;if c.ShouldBindJSON(&cfg)!=nil || cfg.Interval<5 || cfg.Interval>1440{response.BadRequest(c,"检查间隔应为 5–1440 分钟");return}
+   raw,_:=json.Marshal(cfg);if e:=settings.SetCustomSetting(c.Request.Context(),drawingMaintenanceKey,string(raw));e!=nil{response.Error(c,500,"保存维护设置失败");return}
+  }
+  response.Success(c,drawingMaintenanceLoad(c.Request.Context(),settings))
+ }
+}
