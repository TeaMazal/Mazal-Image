+func drawingRandom()string{b:=make([]byte,32);if _,e:=rand.Read(b);e!=nil{panic(e)};return base64.RawURLEncoding.EncodeToString(b)}
+func drawingProxyDigest(p *service.Proxy)string{raw,_:=json.Marshal(p);sum:=sha256.Sum256(raw);return fmt.Sprintf("%x",sum[:])}
