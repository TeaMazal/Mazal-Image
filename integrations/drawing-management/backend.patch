+func TestDrawingReferenceBase64Padding(t *testing.T){
+ // Images of each byte-length remainder must survive data URL normalization.
+ for _,raw:=range []string{"x","xy","xyz","xyzw"}{
+  encoded:=base64.StdEncoding.EncodeToString([]byte(raw))
+  for _,input:=range []string{encoded,"data:image/png;base64,"+encoded}{
