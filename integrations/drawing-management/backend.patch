+ cfg:=DrawingRuntime{PollTimeout:300,PollInterval:3,InitialWait:2,SolverURL:os.Getenv("SUB2API_WEB_SOLVER_URL"),SolverKey:os.Getenv("SUB2API_WEB_SOLVER_KEY")}
