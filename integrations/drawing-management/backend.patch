+func (h *AccountHandler) drawingAccounts(c *gin.Context) ([]service.Account,error) {
+ all:=[]service.Account{}
+ for page:=1;;page++ {
+  items,total,err:=h.adminService.ListAccounts(c.Request.Context(),page,100,"openai","oauth","","",0,"","id","asc","")
+  if err!=nil{return nil,err};all=append(all,items...)
