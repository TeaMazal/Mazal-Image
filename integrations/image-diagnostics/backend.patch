+package service
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+)
+
+func TestDrawingDiagnosticPreservesRejection(t *testing.T) {
+	for _, tc := range []struct {
+		status     int
+		body, code string
+	}{
+		{400, `{"error":{"message":"Tool choice image_generation not found in 'tools' parameter"}}`, "image_tool_rejected"},
+		{429, `{"error":{"type":"usage_limit_reached"}}`, "upstream_rate_limited"},
+		{401, `{"error":{"message":"token_revoked secret-do-not-log"}}`, "authorization_rejected"},
+		{403, `{"error":{"message":"access denied"}}`, "access_forbidden"},
+	} {
+		err := fmt.Errorf("wrapped: %w", &UpstreamFailoverError{StatusCode: tc.status, ResponseBody: []byte(tc.body)})
+		d := drawingImageDiagnostic(err, 200, nil)
+		if d.Code != tc.code || d.HTTPStatus != tc.status || !d.Rejected {
+			t.Fatalf("unexpected diagnostic: %+v", d)
+		}
+		if strings.Contains(d.Message, "secret-do-not-log") {
+			t.Fatal("upstream content leaked")
+		}
+	}
+	d := drawingImageDiagnostic(&OpenAIImagesUpstreamError{StatusCode: 400, Message: "Tool choice image_generation not found in 'tools' parameter"}, 200, nil)
+	if d.Code != "image_tool_rejected" {
+		t.Fatalf("typed error discarded: %+v", d)
+	}
+}
+
+func TestDrawingDiagnosticUncertainIsNotRejected(t *testing.T) {
+	for _, d := range []*DrawingImageTestError{drawingImageDiagnostic(fmt.Errorf("network interrupted"), 200, nil), drawingImageDiagnostic(nil, 200, []byte(`{"data":[]}`)), drawingImageDiagnostic(&UpstreamFailoverError{StatusCode: 502}, 200, nil)} {
+		if d.Rejected {
+			t.Fatalf("uncertain result classified as rejected: %+v", d)
+		}
+	}
+}
+
+func TestDrawingDiagnosticRoutesKeepExactModels(t *testing.T) {
+	a := &Account{Platform: "openai", Type: "oauth"}
+	for _, model := range []string{"gpt-image-2.5-flare", "gpt-image-2.5-sunburst"} {
+		if !IsDrawingImageTestModel(model) || DrawingImageTestRoute(a, model) != "codex_images" {
+			t.Fatal(model)
+		}
+		body, url, err := buildOpenAIImagesOAuthPayload(&OpenAIImagesRequest{Prompt: "blue circle", Model: model, Endpoint: openAIImagesGenerationsEndpoint}, model)
+		if err != nil || !strings.Contains(url, "/images/generations") || !strings.Contains(string(body), model) {
+			t.Fatalf("model changed: %s %s %v", body, url, err)
+		}
+	}
+	if DrawingImageTestRoute(a, "gpt-image-2.5") != "codex_responses" {
+		t.Fatal("generic model silently aliased")
+	}
+	if IsDrawingImageTestModel("untrusted-model") {
+		t.Fatal("unknown model allowed")
+	}
+}
