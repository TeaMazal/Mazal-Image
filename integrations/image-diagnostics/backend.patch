+package service
+
+import (
+	"encoding/json"
+	"errors"
+	"net/http"
+	"strings"
+)
+
+// DrawingImageTestError 只保存诊断分类，不将上游凭据或完整响应写入测试历史。
+type DrawingImageTestError struct {
+	Code       string
+	Message    string
+	HTTPStatus int
+	Rejected   bool
+}
+
+func (e *DrawingImageTestError) Error() string { return e.Message }
+
+func DrawingImageTestModels() []string {
+	return []string{"gpt-image-2", "gpt-image-2.5-flare", "gpt-image-2.5-sunburst", "gpt-image-2.5", "gpt-image-2.6"}
+}
+
+func IsDrawingImageTestModel(model string) bool {
+	for _, candidate := range DrawingImageTestModels() {
+		if candidate == model {
+			return true
+		}
+	}
+	return false
+}
+
+func DrawingImageTestRoute(account *Account, model string) string {
+	if account.IsOpenAIWeb() {
+		return "web"
+	}
+	if usesCodexDirectImages(account.GetMappedModel(model)) {
+		return "codex_images"
+	}
+	return "codex_responses"
+}
+
+func drawingImageDiagnostic(err error, status int, body []byte) *DrawingImageTestError {
+	var failover *UpstreamFailoverError
+	var upstream *OpenAIImagesUpstreamError
+	if errors.As(err, &failover) {
+		status = failover.StatusCode
+		body = failover.ResponseBody
+	}
+	if errors.As(err, &upstream) {
+		status = upstream.StatusCode
+		body, _ = json.Marshal(map[string]any{"error": map[string]string{"message": upstream.Message, "code": upstream.Code}})
+	}
+	d := &DrawingImageTestError{Code: "result_unconfirmed", Message: "请求结果未确认，请检查连接与服务日志；未自动重新提交"}
+	if status >= 400 && status <= 599 {
+		d.HTTPStatus = status
+	}
+	if isOpenAIImageCapabilityLossError(status, body) {
+		d.Code = "image_tool_rejected"
+		d.Message = "上游拒绝 image_generation 工具（HTTP 400）：当前账号、模型与调用路径组合不可用；未自动重试"
+		d.Rejected = true
+		return d
+	}
+	switch status {
+	case http.StatusUnauthorized:
+		d.Code = "authorization_rejected"
+		d.Message = "上游授权失效（HTTP 401），请重新授权该账号；未自动重试"
+		d.Rejected = true
+	case http.StatusForbidden:
+		d.Code = "access_forbidden"
+		d.Message = "上游拒绝访问（HTTP 403），请核对账号权限及代理出口；未自动重试"
+		d.Rejected = true
+	case http.StatusTooManyRequests:
+		d.Code = "upstream_rate_limited"
+		d.Message = "上游限流或额度不足（HTTP 429），请查看账号额度与恢复时间；未自动重试"
+		d.Rejected = true
+	case http.StatusBadRequest, http.StatusUnprocessableEntity:
+		d.Code = "request_rejected"
+		d.Message = "上游拒绝了参数或所选模型，请核对模型与调用路径；未自动重试"
+		d.Rejected = true
+	case http.StatusNotFound, http.StatusMethodNotAllowed:
+		d.Code = "endpoint_unavailable"
+		d.Message = "上游未提供所选接口或模型；未自动重试"
+		d.Rejected = true
+	default:
+		if status >= 500 {
+			d.Code = "upstream_unavailable"
+			d.Message = "上游服务异常，结果未确认；未自动重新提交"
+		}
+	}
+	if err == nil && status < 400 && !strings.Contains(string(body), `"error"`) {
+		d.Code = "image_output_missing"
+		d.Message = "响应中没有可保存的图片，结果未确认；未自动重新提交"
+	}
+	return d
+}
