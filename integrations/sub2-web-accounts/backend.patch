+        """
+        path = "/backend-api/tasks"
+        response = self.session.get(
+            self.base_url + path,
+            headers=self._headers(path, {"Accept": "application/json"}),
+            timeout=timeout_secs,
+        )
+        ensure_ok(response, path)
+        data = response.json()
+        tasks = data.get("tasks", [])
+        if not isinstance(tasks, list):
+            return []
