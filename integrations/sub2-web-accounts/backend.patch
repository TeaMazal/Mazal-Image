+
+class WorkerContractTests(unittest.TestCase):
+    def test_partial_result_never_replays_failed_image(self):
+        image=io.BytesIO();Image.new('RGB',(2,3),'white').save(image,'PNG')
+        calls=[]
+        class Backend:
+            def __init__(self, token): calls.append(token)
+            def close(self): pass
+        def stream(backend, request, index, total):
+            if index == 2: raise RuntimeError('network closed after submit secret=token')
+            yield SimpleNamespace(kind='result', conversation_id='test', data=[{'b64_json':base64.b64encode(image.getvalue()).decode()}])
+        output=io.StringIO()
+        with contextlib.redirect_stdout(output), self.assertRaises(RuntimeError):
+            worker.execute({'model':'gpt-image-2','access_token':'secret','prompt':'test','n':3},Backend,stream)
+        self.assertEqual(calls,['secret','secret'])
+        rows=[json.loads(x) for x in output.getvalue().splitlines()]
+        self.assertEqual(sum(x['type']=='image' for x in rows),1)
+        self.assertNotIn('secret',output.getvalue())
+        self.assertEqual(next(x for x in rows if x['type']=='image')['size'],'2x3')
