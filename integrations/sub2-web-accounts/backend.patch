+"""One selected Web account, JSON stdin -> NDJSON stdout. No HTTP listener/storage."""
+import base64
+import io
+import json
+import sys
+from PIL import Image
+from services.account_service import account_service
+from services.proxy_service import proxy_settings
+from services.openai_backend_api import OpenAIBackendAPI, InvalidAccessTokenError, ImageContentPolicyError
+from services.protocol.conversation import ConversationRequest, stream_image_outputs
+
+def emit(value):
+    print(json.dumps(value, ensure_ascii=True, separators=(',', ':')), flush=True)
+
+class SelectedWebBackend(OpenAIBackendAPI):
+    def _make_retrying_verb(self, original):
+        wrapped = super()._make_retrying_verb(original)
+        def call(url, *args, **kwargs):
+            if str(url).split('?')[0].rstrip('/').endswith('/backend-api/f/conversation'):
+                self._apply_solver_cookies_once()
+                emit({'type': 'submitted'})
+                # A network error after this point has unknown outcome. Never replay.
+                return original(url, *args, **kwargs)
+            return wrapped(url, *args, **kwargs)
+        return call
+
+    def find_conversation_by_prompt(self, *args, **kwargs):
+        # Concurrent identical prompts must never recover another request's image.
+        return ''
+
+def execute(request, backend_factory=SelectedWebBackend, stream=stream_image_outputs):
+    if request.get('model') != 'gpt-image-2' or not request.get('access_token'):
+        raise ValueError('invalid selected Web account request')
+    count=request.get('n', 1)
+    if not isinstance(count,int) or not 1 <= count <= 10: raise ValueError('invalid image count')
+    account_service.account=dict(request.get('account') or {}, source_type='web')
+    proxy_settings.url=request.get('proxy_url') or ''
+    if request.get('mode') == 'probe':
+        backend=backend_factory(request['access_token'])
+        try:
+            info=backend.get_user_info()
+            limits=info.get('limits_progress') or []
+            image_limit=next((x for x in limits if isinstance(x,dict) and x.get('feature_name')=='image_gen'), {})
+            emit({'type':'quota','remaining':image_limit.get('remaining'),'reset_at':image_limit.get('reset_after') or '', 'plan':info.get('type') or ''})
+        finally: backend.close()
+        return
+    for index in range(count):
+        backend=backend_factory(request['access_token'])
+        found=False
+        try:
+            req=ConversationRequest(model='gpt-image-2', prompt=request['prompt'], images=request.get('images') or [], size=request.get('size'), quality=request.get('quality') or 'auto', image_timeout_secs=300)
+            for output in stream(backend, req, index=index+1, total=count):
+                if output.conversation_id:
+                    emit({'type':'progress','conversation_id':output.conversation_id,'index':index})
+                if output.kind != 'result': continue
+                for item in output.data:
+                    raw=base64.b64decode(item['b64_json'], validate=True)
+                    if len(raw)>20*1024*1024: raise ValueError('image too large')
+                    with Image.open(io.BytesIO(raw)) as img:
+                        width,height=img.size;fmt=(img.format or 'PNG').lower();img.verify()
+                    emit({'type':'image','b64_json':item['b64_json'],'size':f'{width}x{height}','output_format':fmt,'index':index})
+                    found=True
+            if not found: raise RuntimeError('no image returned')
+        finally:
+            backend.close()
+    emit({'type':'done'})
+
+def main():
+    try:
+        execute(json.load(sys.stdin))
+    except InvalidAccessTokenError:
+        emit({'type':'error','code':'web_authorization_invalid'})
+    except ImageContentPolicyError:
+        emit({'type':'error','code':'content_policy_violation'})
+    except BaseException:
+        # Do not echo upstream error text, request input, token or traceback.
+        emit({'type':'error','code':'web_generation_unconfirmed'})
+
+if __name__ == '__main__': main()
