+package service
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"os/exec"
+	"strings"
+	"time"
+
+	"github.com/gin-gonic/gin"
+)
+
+type webImageEvent struct {
+	Type   string `json:"type"`
+	Code   string `json:"code"`
+	Base64 string `json:"b64_json"`
+	Size   string `json:"size"`
+	Format string `json:"output_format"`
+	Index  int    `json:"index"`
+}
+
+// A worker failure is deliberately not an UpstreamFailoverError. An upstream
+// conversation may already exist; scheduling another account could double spend.
+func readWebImageEvents(reader io.Reader, maxImages int, onImage func(openAIResponsesImageResult)) (bool, error) {
+	scanner := bufio.NewScanner(reader)
+	scanner.Buffer(make([]byte, 64*1024), 30*1024*1024)
+	count, done := 0, false
+	for scanner.Scan() {
+		var event webImageEvent
+		if json.Unmarshal(scanner.Bytes(), &event) != nil {
+			return false, fmt.Errorf("invalid Web worker event")
+		}
+		if done {
+			return false, fmt.Errorf("Web worker emitted data after completion")
+		}
+		switch event.Type {
+		case "image":
+			raw, err := base64.StdEncoding.DecodeString(event.Base64)
+			if err != nil || len(raw) == 0 || len(raw) > openAIImageMaxDownloadBytes || !isBackfillImageContent(raw) {
+				return false, fmt.Errorf("invalid Web image result")
+			}
+			count++
+			if count > maxImages {
+				return false, fmt.Errorf("Web returned more images than requested")
+			}
+			if event.Format != "png" && event.Format != "jpeg" && event.Format != "webp" && event.Format != "gif" {
+				return false, fmt.Errorf("unsupported Web image format")
+			}
+			onImage(openAIResponsesImageResult{Result: event.Base64, Size: event.Size, OutputFormat: event.Format, Model: "gpt-image-2"})
+		case "done":
+			done = true
+		case "error":
+			code := "web_generation_unconfirmed"
+			if event.Code == "web_authorization_invalid" || event.Code == "content_policy_violation" {
+				code = event.Code
+			}
+			return false, fmt.Errorf("%s", code)
+		case "progress", "submitted":
+		default:
+			return false, fmt.Errorf("unknown Web worker event")
+		}
+	}
+	if scanner.Err() != nil {
+		return false, fmt.Errorf("Web worker output interrupted")
+	}
+	if !done || count == 0 {
+		return false, fmt.Errorf("Web generation result is unconfirmed; request was not retried")
+	}
+	return true, nil
+}
+
+func validateWebImageRequest(account *Account, parsed *OpenAIImagesRequest, mapped string) error {
+	if account == nil || !account.IsOpenAIWeb() || parsed == nil {
+		return fmt.Errorf("invalid Web image request")
+	}
+	if parsed.Model != "gpt-image-2" || (mapped != "" && mapped != "gpt-image-2") || account.GetMappedModel(parsed.Model) != "gpt-image-2" {
+		return fmt.Errorf("this Web source currently supports only gpt-image-2; no model downgrade is allowed")
+	}
+	if parsed.N < 1 || parsed.N > 10 {
+		return fmt.Errorf("Web image count must be between 1 and 10")
+	}
+	if parsed.HasMask || parsed.MaskUpload != nil || parsed.MaskImageURL != "" {
+		return fmt.Errorf("Web image source does not support masks")
+	}
+	if parsed.Background != "" && parsed.Background != "auto" {
+		return fmt.Errorf("Web image source does not support background control")
+	}
+	if parsed.OutputFormat != "" && parsed.OutputFormat != "png" {
+		return fmt.Errorf("Web image source supports PNG output only")
+	}
+	if parsed.OutputCompression != nil || parsed.PartialImages != nil || parsed.InputFidelity != "" || parsed.Style != "" || (parsed.Moderation != "" && parsed.Moderation != "auto") {
+		return fmt.Errorf("requested image options are not supported by Web source")
+	}
+	return nil
+}
+
+func (s *OpenAIGatewayService) forwardOpenAIImagesWeb(ctx context.Context, c *gin.Context, account *Account, parsed *OpenAIImagesRequest, mapped string) (*OpenAIForwardResult, error) {
+	start := time.Now()
+	fail := func(code, message string) error {
+		err := &OpenAIImagesUpstreamError{StatusCode: 502, ErrorType: "upstream_error", Code: code, Message: message}
+		if code == "web_unsupported_parameter" {
+			err.StatusCode = 400
+			err.ErrorType = "invalid_request_error"
+		}
+		if parsed.Stream && c.Writer.Written() {
+			_ = s.writeOpenAIImagesStreamEvent(c, c.Writer, "error", buildOpenAIImagesStreamErrorBodyFromUpstream(err))
+		} else {
+			writeOpenAIImagesUpstreamErrorResponse(c, err)
+		}
+		return err
+	}
+	if err := validateWebImageRequest(account, parsed, mapped); err != nil {
+		return nil, fail("web_unsupported_parameter", err.Error())
+	}
+	upstreamCtx, release := detachUpstreamContext(ctx)
+	defer release()
+	upstreamCtx, cancel := context.WithTimeout(upstreamCtx, time.Duration(parsed.N)*20*time.Minute)
+	defer cancel()
+	token, _, err := s.GetAccessToken(upstreamCtx, account)
+	if err != nil {
+		return nil, fail("web_authorization_invalid", "Web account authorization is unavailable")
+	}
+	images := make([]string, 0, len(parsed.Uploads)+len(parsed.InputImageURLs))
+	for _, upload := range parsed.Uploads {
+		images = append(images, base64.StdEncoding.EncodeToString(upload.Data))
+	}
+	for _, url := range parsed.InputImageURLs {
+		encoded, e := s.fetchOpenAIImageURLBase64(upstreamCtx, account, url)
+		if e != nil {
+			return nil, fail("web_unsupported_parameter", "Reference image could not be read")
+		}
+		images = append(images, encoded)
+	}
+	proxy := ""
+	if account.ProxyID != nil && account.Proxy != nil {
+		proxy = account.Proxy.URL()
+	}
+	// Only the assigned credential goes over stdin; never arguments or disk.
+	payload := map[string]any{"access_token": token, "model": parsed.Model, "prompt": parsed.Prompt, "n": parsed.N, "size": parsed.Size, "quality": parsed.Quality, "images": images, "proxy_url": proxy, "account": map[string]any{"fp": account.Credentials["web_fingerprint"]}}
+	input, err := json.Marshal(payload)
+	if err != nil {
+		return nil, err
+	}
+	python := strings.TrimSpace(os.Getenv("SUB2API_WEB_PYTHON"))
+	if python == "" {
+		python = "/opt/web-runtime/bin/python"
+	}
+	worker := strings.TrimSpace(os.Getenv("SUB2API_WEB_WORKER"))
+	if worker == "" {
+		worker = "/app/resources/chatgpt_web/worker.py"
+	}
+	cmd := exec.CommandContext(upstreamCtx, python, "-B", worker)
+	cmd.Stdin = bytes.NewReader(input)
+	cmd.Stderr = io.Discard
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		return nil, fail("web_worker_unavailable", "Web image module is unavailable")
+	}
+	if err = cmd.Start(); err != nil {
+		return nil, fail("web_worker_unavailable", "Web image module could not start")
+	}
+	SetOpsUpstreamModel(c, "gpt-image-2")
+	SetActualOpenAIUpstreamEndpoint(c, "/backend-api/f/conversation")
+	if parsed.Stream {
+		c.Header("Content-Type", "text/event-stream")
+		c.Header("Cache-Control", "no-cache")
+		c.Header("X-Accel-Buffering", "no")
+		c.Status(http.StatusOK)
+	}
+	result := &OpenAIForwardResult{Model: parsed.Model, UpstreamModel: "gpt-image-2", UpstreamEndpoint: "/backend-api/f/conversation", Stream: parsed.Stream, ImageEndpoint: true, ImageSize: parsed.SizeTier, ImageInputSize: parsed.Size}
+	collected := make([]openAIResponsesImageResult, 0, parsed.N)
+	imageEvents := make(chan openAIResponsesImageResult)
+	finished := make(chan error, 1)
+	go func() {
+		_, e := readWebImageEvents(stdout, parsed.N, func(img openAIResponsesImageResult) { imageEvents <- img })
+		finished <- e
+	}()
+	heartbeat := time.NewTicker(15 * time.Second)
+	defer heartbeat.Stop()
+	var readErr error
+	reading := true
+	for reading {
+		select {
+		case img := <-imageEvents:
+			result.ImageCount++
+			result.ImageOutputSizes = append(result.ImageOutputSizes, img.Size)
+			if result.FirstTokenMs == nil {
+				ms := int(time.Since(start).Milliseconds())
+				result.FirstTokenMs = &ms
+			}
+			if parsed.Stream {
+				event := openAIImagesStreamPrefix(parsed) + ".completed"
+				_ = s.writeOpenAIImagesStreamEvent(c, c.Writer, event, buildOpenAIImagesStreamCompletedPayload(event, img, parsed.ResponseFormat, start.Unix(), nil))
+			} else {
+				collected = append(collected, img)
+			}
+		case readErr = <-finished:
+			reading = false
+		case <-heartbeat.C:
+			if parsed.Stream {
+				_, _ = c.Writer.Write([]byte(": keep-alive\n\n"))
+				c.Writer.Flush()
+			}
+		}
+	}
+	// Stop on protocol errors; never leave a blocked child writing to a full pipe.
+	if readErr != nil {
+		cancel()
+	}
+	waitErr := cmd.Wait()
+	result.Duration = time.Since(start)
+	SetOpsLatencyMs(c, OpsUpstreamLatencyMsKey, result.Duration.Milliseconds())
+	if result.ImageCount > 0 && !parsed.Stream {
+		body, e := buildOpenAIImagesAPIResponse(collected, start.Unix(), nil, collected[0], parsed.ResponseFormat)
+		if e != nil {
+			return result, e
+		}
+		StopOpenAIImagesJSONKeepaliveCommitted(c)
+		c.Data(http.StatusOK, "application/json", body)
+	}
+	if readErr != nil || waitErr != nil {
+		if result.ImageCount > 0 {
+			if parsed.Stream {
+				_ = s.writeOpenAIImagesStreamEvent(c, c.Writer, "error", buildOpenAIImagesStreamErrorBody("Web image batch partially completed; remaining requests were not retried"))
+			}
+			return result, fmt.Errorf("Web image batch partially completed; remaining requests were not retried")
+		}
+		code := "web_generation_unconfirmed"
+		if readErr != nil && readErr.Error() == "web_authorization_invalid" {
+			code = "web_authorization_invalid"
+			if s.accountRepo != nil {
+				updateCtx, stop := context.WithTimeout(context.Background(), 5*time.Second)
+				_ = s.accountRepo.SetError(updateCtx, account.ID, "Web authorization invalid; re-import authorization")
+				stop()
+			}
+		}
+		return nil, fail(code, "Web image generation did not return a confirmed image; it was not resubmitted")
+	}
+	return result, nil
+}
