+package service
+
+import (
+	"encoding/base64"
+	"encoding/json"
+	infraerrors "github.com/Wei-Shaw/sub2api/internal/pkg/errors"
+	"strings"
+)
+
+const OpenAIWebClientID = "app_2SKx67EdpoN0G6j64rFvigXD"
+const openAICodexClientID = "app_EMoamEEZ73f0CkXaXp7hrann"
+
+// Unmarked existing subscriptions remain Codex. Web is an explicit auth source.
+func (a *Account) IsOpenAIWeb() bool {
+	return a != nil && a.Platform == PlatformOpenAI && (a.GetCredential("source_type") == "web" || a.GetCredential("client_id") == OpenAIWebClientID)
+}
+
+func normalizeOpenAIWebCredentials(platform, typ string, credentials map[string]any) error {
+	if platform != PlatformOpenAI || credentials == nil {
+		return nil
+	}
+	source, _ := credentials["source_type"].(string)
+	client, _ := credentials["client_id"].(string)
+	if source != "" && source != "web" && source != "codex" {
+		return infraerrors.BadRequest("INVALID_WEB_AUTHORIZATION", "unsupported OpenAI authorization source")
+	}
+	if source == "codex" && client == OpenAIWebClientID {
+		return infraerrors.BadRequest("INVALID_WEB_AUTHORIZATION", "Web client cannot be marked Codex")
+	}
+	if source != "web" && client != OpenAIWebClientID {
+		return nil
+	}
+	if typ != AccountTypeOAuth {
+		return infraerrors.BadRequest("INVALID_WEB_AUTHORIZATION", "Web authorization requires OAuth account type")
+	}
+	if client == openAICodexClientID {
+		return infraerrors.BadRequest("INVALID_WEB_AUTHORIZATION", "Codex authorization cannot be marked Web")
+	}
+	token, _ := credentials["access_token"].(string)
+	if strings.TrimSpace(token) == "" {
+		return infraerrors.BadRequest("INVALID_WEB_AUTHORIZATION", "Web access_token is required")
+	}
+	// JWT metadata is only an import hint; upstream still validates authorization.
+	parts := strings.Split(token, ".")
+	if len(parts) == 3 {
+		raw, err := base64.RawURLEncoding.DecodeString(parts[1])
+		if err == nil {
+			var claims map[string]any
+			if json.Unmarshal(raw, &claims) == nil {
+				claimClient, _ := claims["client_id"].(string)
+				if claimClient == openAICodexClientID {
+					return infraerrors.BadRequest("INVALID_WEB_AUTHORIZATION", "Codex token cannot be marked Web")
+				}
+				if claimClient != "" {
+					if client != "" && client != claimClient {
+						return infraerrors.BadRequest("INVALID_WEB_AUTHORIZATION", "authorization client does not match token")
+					}
+					client = claimClient
+				}
+				if _, exists := credentials["expires_at"]; !exists {
+					if exp, ok := claims["exp"].(float64); ok {
+						credentials["expires_at"] = int64(exp)
+					}
+				}
+			}
+		}
+	}
+	if client == "" {
+		client = OpenAIWebClientID
+	}
+	credentials["source_type"] = "web"
+	credentials["client_id"] = client
+	return nil
+}
