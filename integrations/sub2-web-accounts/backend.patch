+)
+
+type WebImageUsage struct {
+	Remaining *int      `json:"remaining"`
+	ResetAt   string    `json:"reset_at,omitempty"`
+	Plan      string    `json:"plan,omitempty"`
+	CheckedAt time.Time `json:"checked_at"`
+}
+
+func webWorkerPaths() (string, string) {
+	python := strings.TrimSpace(os.Getenv("SUB2API_WEB_PYTHON"))
+	if python == "" {
+		python = "/opt/web-runtime/bin/python"
+	}
+	worker := strings.TrimSpace(os.Getenv("SUB2API_WEB_WORKER"))
+	if worker == "" {
+		worker = "/app/resources/chatgpt_web/worker.py"
+	}
+	return python, worker
+}
+
+func (s *AccountUsageService) getWebImageUsage(ctx context.Context, account *Account, force bool) (*UsageInfo, error) {
+	usage := &UsageInfo{Source: "chatgpt_web"}
+	if raw, ok := account.Extra["web_image_usage"]; ok {
+		data, _ := json.Marshal(raw)
+		var cached WebImageUsage
+		if json.Unmarshal(data, &cached) == nil {
+			usage.WebImageUsage = &cached
+			usage.UpdatedAt = &cached.CheckedAt
+		}
+	}
+	// Listing is passive; only an explicit refresh contacts the Web service.
+	if !force {
+		return usage, nil
+	}
+	token := account.GetCredential("access_token")
+	if s.openAIQuotaService != nil && s.openAIQuotaService.tokenProvider != nil {
+		refreshed, err := s.openAIQuotaService.tokenProvider.GetAccessToken(ctx, account)
+		if err != nil {
+			usage.Error = "Web authorization unavailable"
+			return usage, nil
+		}
+		token = refreshed
+	}
+	proxy := ""
+	if account.Proxy != nil {
+		proxy = account.Proxy.URL()
+	}
+	input, _ := json.Marshal(map[string]any{"mode": "probe", "model": "gpt-image-2", "access_token": token, "proxy_url": proxy, "account": map[string]any{"fp": account.Credentials["web_fingerprint"]}})
+	ctx, cancel := context.WithTimeout(ctx, 90*time.Second)
+	defer cancel()
+	python, worker := webWorkerPaths()
+	cmd := exec.CommandContext(ctx, python, "-B", worker)
+	cmd.Stdin = bytes.NewReader(input)
+	cmd.Stderr = io.Discard
+	out, err := cmd.Output()
+	if err != nil {
+		usage.Error = "Web authorization check failed"
+		return usage, nil
+	}
+	var response struct {
+		Type string `json:"type"`
+		WebImageUsage
+	}
+	if len(out) > 65536 || json.Unmarshal(out, &response) != nil || response.Type != "quota" {
+		usage.Error = "Web authorization check failed; check token and proxy"
+		return usage, nil
+	}
+	response.CheckedAt = time.Now()
+	usage.WebImageUsage = &response.WebImageUsage
+	usage.UpdatedAt = &response.CheckedAt
+	if err := s.accountRepo.UpdateExtra(ctx, account.ID, map[string]any{"web_image_usage": response.WebImageUsage}); err != nil {
+		return nil, fmt.Errorf("could not save Web quota snapshot")
+	}
+	return usage, nil
+}
