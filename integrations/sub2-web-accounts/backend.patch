+        # 按 conversation_id 或 task_id 过滤
+        if conversation_id:
+            tasks = [
+                t for t in tasks
+                if isinstance(t, dict) and (
+                    t.get("conversation_id") == conversation_id
+                    or t.get("original_conversation_id") == conversation_id
+                )
+            ]
+        if task_id:
