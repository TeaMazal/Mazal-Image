+package service
+
+import (
+	"encoding/json"
+	"github.com/gin-gonic/gin"
+	"net/http/httptest"
+	"strings"
+	"time"
+)
+
+func (s *AccountTestService) testOpenAIWebConnection(c *gin.Context, account *Account, model, prompt, mode string) error {
+	if mode == AccountTestModeCompact || (model != "" && model != "gpt-image-2") {
+		return s.sendErrorAndEnd(c, "Web accounts currently support Image 2 testing only")
+	}
+	if s.openaiGatewayService == nil {
+		return s.sendErrorAndEnd(c, "Web image service is unavailable")
+	}
+	if strings.TrimSpace(prompt) == "" {
+		prompt = defaultOpenAIImageTestPrompt
+	}
+	c.Header("Content-Type", "text/event-stream")
+	c.Header("Cache-Control", "no-cache")
+	c.Header("X-Accel-Buffering", "no")
+	s.sendEvent(c, TestEvent{Type: "test_start", Model: "gpt-image-2"})
+	recorder := httptest.NewRecorder()
+	inner, _ := gin.CreateTestContext(recorder)
+	inner.Request = c.Request.Clone(c.Request.Context())
+	done := make(chan error, 1)
+	go func() {
+		_, err := s.openaiGatewayService.ForwardImages(inner.Request.Context(), inner, account, nil, &OpenAIImagesRequest{Endpoint: openAIImagesGenerationsEndpoint, Model: "gpt-image-2", Prompt: prompt, N: 1, ResponseFormat: "b64_json", SizeTier: "1K"}, "")
+		done <- err
+	}()
+	heartbeat := time.NewTicker(15 * time.Second)
+	defer heartbeat.Stop()
+	for {
+		select {
+		case err := <-done:
+			if err != nil {
+				return s.sendErrorAndEnd(c, "Web image test failed; check authorization, quota and proxy. The request was not resubmitted.")
+			}
+			var response struct {
+				OutputFormat string `json:"output_format"`
+				Data         []struct {
+					Base64 string `json:"b64_json"`
+				} `json:"data"`
+			}
+			if json.Unmarshal(recorder.Body.Bytes(), &response) != nil || len(response.Data) == 0 {
+				return s.sendErrorAndEnd(c, "Web image test returned no confirmed image")
+			}
+			mime := openAIImageOutputMIMEType(response.OutputFormat)
+			for _, item := range response.Data {
+				s.sendEvent(c, TestEvent{Type: "image", ImageURL: "data:" + mime + ";base64," + item.Base64, MimeType: mime})
+			}
+			s.sendEvent(c, TestEvent{Type: "test_complete", Success: true})
+			return nil
+		case <-heartbeat.C:
+			_, _ = c.Writer.Write([]byte(": keep-alive\n\n"))
+			c.Writer.Flush()
+		}
+	}
+}
