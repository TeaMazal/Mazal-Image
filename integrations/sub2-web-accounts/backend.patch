+package service
+
+import (
+	"encoding/base64"
+	"github.com/stretchr/testify/require"
+	"testing"
+)
+
+func TestWebPreservesActualAuthorizationClient(t *testing.T) {
+	payload := base64.RawURLEncoding.EncodeToString([]byte(`{"client_id":"app_another_web_client","exp":1893456000}`))
+	creds := map[string]any{"source_type": "web", "access_token": "header." + payload + ".signature"}
+	require.NoError(t, normalizeOpenAIWebCredentials(PlatformOpenAI, AccountTypeOAuth, creds))
+	require.Equal(t, "app_another_web_client", creds["client_id"])
+	creds["client_id"] = OpenAIWebClientID
+	require.Error(t, normalizeOpenAIWebCredentials(PlatformOpenAI, AccountTypeOAuth, creds))
+}
+
+func webTestAccount() *Account {
+	return &Account{Platform: PlatformOpenAI, Type: AccountTypeOAuth, Credentials: map[string]any{"source_type": "web", "access_token": "test-token", "client_id": OpenAIWebClientID}}
+}
+
+func TestWebAccountSourceAndScheduling(t *testing.T) {
+	a := webTestAccount()
+	require.True(t, a.IsOpenAIWeb())
+	require.True(t, supportsOpenAIRequestModel(a, "gpt-image-2", false))
+	for _, model := range []string{"gpt-image-2.5", "gpt-image-2.5-flare", "gpt-6.1-sol", ""} {
+		require.False(t, supportsOpenAIRequestModel(a, model, false), model)
+	}
+	require.False(t, accountSupportsOpenAICapabilities(a, "", ""))
+	require.True(t, accountSupportsOpenAICapabilities(a, "", OpenAIImagesCapabilityBasic))
+	require.False(t, supportsOpenAIRequestModel(a, "gpt-image-2", true))
+	a.Credentials["model_mapping"] = map[string]any{"gpt-image-2": "gpt-image-2.5-flare"}
+	require.False(t, supportsOpenAIRequestModel(a, "gpt-image-2", false))
+	require.False(t, (&Account{Platform: PlatformOpenAI, Type: AccountTypeOAuth}).IsOpenAIWeb())
+}
+
+func TestWebAccountCredentials(t *testing.T) {
+	for _, tc := range []struct {
+		source, client, typ string
+		valid               bool
+	}{
+		{"web", "", AccountTypeOAuth, true}, {"", OpenAIWebClientID, AccountTypeOAuth, true},
+		{"web", "app_EMoamEEZ73f0CkXaXp7hrann", AccountTypeOAuth, false},
+		{"codex", OpenAIWebClientID, AccountTypeOAuth, false}, {"web", "", AccountTypeAPIKey, false},
+	} {
+		c := map[string]any{"source_type": tc.source, "client_id": tc.client, "access_token": "test"}
+		err := normalizeOpenAIWebCredentials(PlatformOpenAI, tc.typ, c)
+		if tc.valid {
+			require.NoError(t, err)
+			require.Equal(t, OpenAIWebClientID, c["client_id"])
+			require.Equal(t, "web", c["source_type"])
+		} else {
+			require.Error(t, err)
+		}
+	}
+}
