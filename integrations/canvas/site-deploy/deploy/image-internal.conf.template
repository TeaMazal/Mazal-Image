server {
    listen 8443 ssl;
    server_name img.souhub.top;
    ssl_certificate /etc/nginx/image-tls/img.souhub.top.crt;
    ssl_certificate_key /etc/nginx/image-tls/img.souhub.top.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 30m;
    add_header X-Content-Type-Options nosniff always;
    location ^~ /engine/v1/ {
        proxy_set_header Host img.souhub.top;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Mazal-Engine-Only 1;
        proxy_read_timeout 650s;
        proxy_send_timeout 650s;
        proxy_buffering off;
        proxy_pass http://backend:8080/v1/;
    }
    location / { return 404; }
}
