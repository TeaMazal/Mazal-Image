+type Media struct {
+	Name      string `json:"name"`
+	Thumbnail string `json:"thumbnail,omitempty"`
+	State     string `json:"state"`
+	Kind      string `json:"kind"`
+	Bytes     int64  `json:"bytes"`
+}
+type Record struct {
+	ID             string       `json:"id"`
+	UserID         int64        `json:"user_id"`
+	APIKeyID       int64        `json:"api_key_id"`
+	RequestID      string       `json:"request_id"`
+	RoundID        string       `json:"round_id,omitempty"`
+	ConversationID string       `json:"conversation_id,omitempty"`
+	Prompt         string       `json:"prompt"`
+	Model          string       `json:"model"`
+	Size           string       `json:"size"`
+	Quality        string       `json:"quality"`
+	Mode           string       `json:"mode"`
+	Count          int          `json:"n"`
+	State          string       `json:"state"`
+	Created        int64        `json:"created_at"`
+	Duration       int64        `json:"duration_ms"`
+	HTTPStatus     int          `json:"http_status"`
+	Images         []Media      `json:"images"`
+	References     []Media      `json:"references"`
+	Note           string       `json:"note,omitempty"`
+	RoundTotal     int          `json:"round_total,omitempty"`
+	Requests       []RequestRef `json:"requests,omitempty"`
+}
+type RequestRef struct {
+	ID        string `json:"id"`
+	RequestID string `json:"request_id"`
+	State     string `json:"state"`
+}
+
+// Group only explicit round IDs within the same authenticated user and API key.
+// No timestamp/prompt heuristic can accidentally combine independent conversations.
+func Group(rows []Record) []Record {
+	out := []Record{}
+	positions := map[string]int{}
+	running := map[string]bool{}
+	allFailed := map[string]bool{}
+	for _, r := range rows {
+		key := r.ID
+		if r.RoundID != "" {
+			key = fmt.Sprintf("%d:%d:%s:%s", r.UserID, r.APIKeyID, r.ConversationID, r.RoundID)
+		}
+		ref := RequestRef{r.ID, r.RequestID, r.State}
+		i, found := positions[key]
+		if !found {
+			r.Requests = []RequestRef{ref}
+			positions[key] = len(out)
+			out = append(out, r)
+			running[key] = r.State == "running" || r.State == "queued"
+			allFailed[key] = r.State == "failed"
+			continue
+		}
+		v := &out[i]
+		end := max(v.Created*1000+v.Duration, r.Created*1000+r.Duration)
+		v.Created = min(v.Created, r.Created)
+		v.Duration = end - v.Created*1000
+		v.Count += r.Count
+		v.RoundTotal = max(v.RoundTotal, r.RoundTotal)
+		v.Images = append(v.Images, r.Images...)
+		v.Requests = append(v.Requests, ref)
+		running[key] = running[key] || r.State == "running" || r.State == "queued"
+		allFailed[key] = allFailed[key] && r.State == "failed"
+	}
+	for key, i := range positions {
+		r := &out[i]
+		r.Count = max(r.Count, r.RoundTotal)
+		if len(r.Requests) > 1 || r.RoundTotal > 1 {
+			if running[key] {
+				r.State = "running"
+			} else if len(r.Images) >= r.Count {
+				r.State = "completed"
+			} else if len(r.Images) > 0 {
+				r.State = "partial"
+			} else if allFailed[key] {
+				r.State = "failed"
+			} else {
+				r.State = "unconfirmed"
+			}
+		}
+	}
+	return out
+}
+
+var safeID = regexp.MustCompile(`^[a-f0-9]{32}$`)
+var Active sync.Map
+var safeMedia = regexp.MustCompile(`^[a-f0-9]{32}-(?:result|reference)-[0-9]+(?:-thumb)?\.(?:png|jpg|webp|gif)$`)
+
+func Root() string {
+	if p := os.Getenv("SUB2API_DRAWING_RECORD_DIR"); p != "" {
+		return p
+	}
+	return "/app/data/drawing-records"
+}
+func New(user, key int64) Record {
+	b := make([]byte, 16)
+	_, _ = rand.Read(b)
+	return Record{ID: hex.EncodeToString(b), UserID: user, APIKeyID: key, Created: time.Now().Unix(), State: "running", Count: 1, Images: []Media{}, References: []Media{}}
+}
+func Save(r Record) error {
+	if !safeID.MatchString(r.ID) {
+		return fmt.Errorf("invalid record")
+	}
+	if e := os.MkdirAll(Root(), 0700); e != nil {
+		return e
+	}
+	raw, e := json.Marshal(r)
+	if e != nil {
+		return e
+	}
+	f, e := os.CreateTemp(Root(), ".record-")
+	if e != nil {
+		return e
+	}
+	name := f.Name()
+	defer os.Remove(name)
+	_, e = f.Write(raw)
+	if e == nil {
+		e = f.Sync()
+	}
+	f.Close()
+	if e != nil {
+		return e
+	}
+	return os.Rename(name, filepath.Join(Root(), r.ID+".json"))
+}
+func Read(id string) (Record, error) {
+	var r Record
+	if !safeID.MatchString(id) {
+		return r, os.ErrNotExist
+	}
+	b, e := os.ReadFile(filepath.Join(Root(), id+".json"))
+	if e == nil {
+		e = json.Unmarshal(b, &r)
+	}
+	if r.State == "running" {
+		if _, active := Active.Load(r.ID); !active {
+			r.State = "unconfirmed"
+			r.Note = "执行进程已结束，请核对结果与账单；未自动重发"
+		}
+	}
+	return r, e
+}
+func List() ([]Record, error) {
+	entries, e := os.ReadDir(Root())
+	if os.IsNotExist(e) {
+		return []Record{}, nil
+	}
+	if e != nil {
+		return nil, e
+	}
+	rows := []Record{}
+	for _, f := range entries {
+		if !strings.HasSuffix(f.Name(), ".json") {
+			continue
+		}
+		r, e := Read(strings.TrimSuffix(f.Name(), ".json"))
+		if e == nil {
+			rows = append(rows, r)
+		}
+	}
+	sort.Slice(rows, func(i, j int) bool {
+		if rows[i].Created == rows[j].Created {
+			return rows[i].ID > rows[j].ID
+		}
+		return rows[i].Created > rows[j].Created
+	})
+	return rows, nil
+}
+func MediaPath(name string) (string, error) {
+	if !safeMedia.MatchString(name) {
+		return "", os.ErrNotExist
+	}
+	return filepath.Join(Root(), name), nil
+}
+func MediaExists(m Media) bool {
+	p, e := MediaPath(m.Name)
+	if e != nil {
+		return false
+	}
+	_, e = os.Stat(p)
+	return e == nil
+}
+
+// Copy at most the audit budget, while transparently forwarding every byte.
+type Capture struct {
+	File      *os.File
+	Remaining int64
+	Truncated bool
+	Failed    bool
+	mu        sync.Mutex
+}
+
+func NewCapture() (*Capture, error) {
+	if e := os.MkdirAll(Root(), 0700); e != nil {
+		return nil, e
+	}
+	f, e := os.CreateTemp(Root(), ".capture-")
+	return &Capture{File: f, Remaining: 256 << 20}, e
+}
+func (c *Capture) Write(p []byte) (int, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	n := len(p)
+	if c.File == nil {
+		return n, nil
+	}
+	part := p
+	if int64(len(part)) > c.Remaining {
+		part = part[:c.Remaining]
+		c.Truncated = true
+	}
+	if len(part) > 0 {
+		if _, e := c.File.Write(part); e != nil {
+			c.Failed = true
+		}
+		c.Remaining -= int64(len(part))
+	}
+	return n, nil
+}
+func (c *Capture) Close() {
+	if c != nil && c.File != nil {
+		name := c.File.Name()
+		c.File.Close()
+		os.Remove(name)
+	}
+}
+func (c *Capture) Bytes() []byte {
+	if c == nil || c.File == nil {
+		return nil
+	}
+	c.File.Seek(0, 0)
+	b, _ := io.ReadAll(c.File)
+	return b
+}
+
+func storeMedia(r *Record, raw []byte, kind string, index int) Media {
+	m := Media{Kind: kind, State: "unavailable"}
+	if len(raw) == 0 || len(raw) > 32<<20 {
+		return m
+	}
+	ext := ""
+	switch http.DetectContentType(raw) {
+	case "image/png":
+		ext = "png"
+	case "image/jpeg":
+		ext = "jpg"
+	case "image/webp":
+		ext = "webp"
+	case "image/gif":
+		ext = "gif"
+	}
+	if ext == "" {
+		return m
+	}
+	m.Name = fmt.Sprintf("%s-%s-%d.%s", r.ID, kind, index, ext)
+	p, _ := MediaPath(m.Name)
+	if os.WriteFile(p, raw, 0600) != nil {
+		m.Name = ""
+		return m
+	}
+	m.State = "saved"
+	m.Bytes = int64(len(raw))
+	// Bound decoded dimensions before allocating a preview. Original remains usable.
+	cfg, _, e := image.DecodeConfig(bytes.NewReader(raw))
+	if e != nil || int64(cfg.Width)*int64(cfg.Height) > 40_000_000 {
+		return m
+	}
+	src, _, e := image.Decode(bytes.NewReader(raw))
+	if e != nil {
+		return m
+	}
+	w, h := cfg.Width, cfg.Height
+	if w > h {
+		h = max(1, h*240/w)
+		w = 240
+	} else {
+		w = max(1, w*240/h)
+		h = 240
+	}
+	dst := image.NewRGBA(image.Rect(0, 0, w, h))
+	bounds := src.Bounds()
+	for y := 0; y < h; y++ {
+		for x := 0; x < w; x++ {
+			dst.Set(x, y, src.At(bounds.Min.X+x*cfg.Width/w, bounds.Min.Y+y*cfg.Height/h))
+		}
+	}
+	thumb := fmt.Sprintf("%s-%s-%d-thumb.jpg", r.ID, kind, index)
+	tp, _ := MediaPath(thumb)
+	f, e := os.OpenFile(tp, os.O_CREATE|os.O_WRONLY|os.O_TRUNC, 0600)
+	if e == nil {
+		e = jpeg.Encode(f, dst, &jpeg.Options{Quality: 75})
+		f.Close()
+		if e == nil {
+			m.Thumbnail = thumb
+		}
+	}
+	return m
+}
+func inline(value string) []byte {
+	if strings.HasPrefix(value, "data:image/") {
+		parts := strings.SplitN(value, ",", 2)
+		if len(parts) != 2 || !strings.HasSuffix(parts[0], ";base64") {
+			return nil
+		}
+		value = parts[1]
+	}
+	if len(value) > 45<<20 {
+		return nil
+	}
+	b, _ := base64.StdEncoding.DecodeString(value)
+	return b
+}
+func stringField(v map[string]any, k string) string { s, _ := v[k].(string); return s }
+func ParseRequest(r *Record, body []byte, contentType string) {
+	var v map[string]any
+	if strings.HasPrefix(contentType, "multipart/") {
+		_, params, e := mime.ParseMediaType(contentType)
+		if e != nil {
+			return
+		}
+		reader := multipart.NewReader(bytes.NewReader(body), params["boundary"])
+		v = map[string]any{}
+		for {
+			part, e := reader.NextPart()
+			if e != nil {
+				break
+			}
+			name := part.FormName()
+			if part.FileName() != "" {
+				if (name == "image" || name == "image[]" || name == "images" || name == "mask") && len(r.References) < 8 {
+					raw, _ := io.ReadAll(io.LimitReader(part, 32<<20+1))
+					r.References = append(r.References, storeMedia(r, raw, "reference", len(r.References)))
+				}
+			} else {
+				raw, _ := io.ReadAll(io.LimitReader(part, 32001))
+				v[name] = string(raw)
+			}
+		}
+	} else {
+		if json.Unmarshal(body, &v) != nil {
+			return
+		}
+		var refs []any
+		switch images := v["images"].(type) {
+		case []any:
+			refs = images
+		}
+		if img, ok := v["image"].(string); ok {
+			refs = append(refs, img)
+		}
+		for _, item := range refs {
+			if len(r.References) >= 8 {
+				break
+			}
+			s, _ := item.(string)
+			if obj, ok := item.(map[string]any); ok {
+				s = stringField(obj, "image_url")
+				if s == "" {
+					s = stringField(obj, "url")
+				}
+			}
+			r.References = append(r.References, storeMedia(r, inline(s), "reference", len(r.References)))
+		}
+	}
+	r.Prompt = stringField(v, "prompt")
+	if len(r.Prompt) > 32000 {
+		r.Prompt = r.Prompt[:32000]
+	}
+	r.Model = stringField(v, "model")
+	r.Size = stringField(v, "size")
+	r.Quality = stringField(v, "quality")
+	switch n := v["n"].(type) {
+	case float64:
+		r.Count = int(n)
+	case string:
+		r.Count, _ = strconv.Atoi(n)
+	}
+	if r.Count < 1 {
+		r.Count = 1
+	}
+}
+func ParseResponse(r *Record, body []byte, contentType string) {
+	add := func(item map[string]any) {
+		s := stringField(item, "b64_json")
+		if s == "" {
+			s = stringField(item, "url")
+		}
+		if s == "" {
+			s = stringField(item, "result")
+		}
+		if s == "" {
+			return
+		}
+		raw := inline(s)
+		r.Images = append(r.Images, storeMedia(r, raw, "result", len(r.Images)))
+	}
+	parse := func(raw []byte) {
+		var v map[string]any
+		if json.Unmarshal(raw, &v) != nil {
+			return
+		}
+		if a, ok := v["data"].([]any); ok {
+			for _, x := range a {
+				if m, ok := x.(map[string]any); ok {
+					add(m)
+				}
+			}
+		}
+		typ := stringField(v, "type")
+		if strings.Contains(typ, "completed") {
+			add(v)
+		}
+		if err, ok := v["error"].(map[string]any); ok {
+			r.Note = stringField(err, "message")
+			if len(r.Note) > 400 {
+				r.Note = r.Note[:400]
+			}
+		}
+	}
+	if strings.Contains(contentType, "text/event-stream") {
+		scanner := bufio.NewScanner(bytes.NewReader(body))
+		scanner.Buffer(make([]byte, 4096), 48<<20)
+		for scanner.Scan() {
+			line := scanner.Bytes()
+			if bytes.HasPrefix(line, []byte("data:")) {
+				parse(bytes.TrimSpace(line[5:]))
+			}
+		}
+		if scanner.Err() != nil {
+			r.Note = "部分流式结果未能归档，请核对实际账单"
+		}
+	} else {
+		parse(body)
+	}
+	saved := 0
+	for _, m := range r.Images {
+		if m.State == "saved" {
+			saved++
+		}
+	}
+	if r.HTTPStatus >= 400 {
+		r.State = "failed"
+	} else if len(r.Images) >= r.Count {
+		r.State = "completed"
+	} else if len(r.Images) > 0 {
+		r.State = "partial"
+	} else {
+		r.State = "unconfirmed"
+	}
+	if saved < len(r.Images) {
+		r.Note = "结果未在本地留存；外部临时链接不会自动下载"
+	}
+}
