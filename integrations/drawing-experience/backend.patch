+package drawingrecord
+
+import (
+	"bytes"
+	"encoding/base64"
+	"encoding/json"
+	"image"
+	"image/png"
+	"os"
+	"strings"
+	"testing"
+)
+
+func sample() string {
+	var b bytes.Buffer
+	_ = png.Encode(&b, image.NewRGBA(image.Rect(0, 0, 12, 8)))
+	return base64.StdEncoding.EncodeToString(b.Bytes())
+}
+func TestPrivateResultsAndMetadata(t *testing.T) {
+	t.Setenv("SUB2API_DRAWING_RECORD_DIR", t.TempDir())
+	r := New(8, 22)
+	r.HTTPStatus = 200
+	ParseRequest(&r, []byte(`{"prompt":"茶杯 <script>","model":"gpt-image-2","n":2}`), "application/json")
+	b, _ := json.Marshal(map[string]any{"data": []any{map[string]string{"b64_json": sample()}, map[string]string{"url": "https://untrusted.invalid/private"}}})
+	ParseResponse(&r, b, "application/json")
+	if r.State != "completed" || len(r.Images) != 2 || r.Images[0].State != "saved" || r.Images[1].State != "unavailable" {
+		t.Fatalf("unexpected result: %+v", r)
+	}
+	if r.Images[0].Thumbnail == "" {
+		t.Fatal("thumbnail missing")
+	}
+	if e := Save(r); e != nil {
+		t.Fatal(e)
+	}
+	got, e := Read(r.ID)
+	if e != nil || got.UserID != 8 || got.Prompt != r.Prompt {
+		t.Fatal("record roundtrip failed")
+	}
+	p, _ := MediaPath(r.Images[0].Name)
+	info, _ := os.Stat(p)
+	if info.Mode().Perm() != 0600 {
+		t.Fatal("media must remain private")
+	}
+	raw, _ := os.ReadFile(Root() + "/" + r.ID + ".json")
+	if bytes.Contains(raw, []byte("untrusted.invalid")) {
+		t.Fatal("remote URL must not persist")
+	}
+}
+func TestTraversalAndMalformedMedia(t *testing.T) {
+	t.Setenv("SUB2API_DRAWING_RECORD_DIR", t.TempDir())
+	for _, p := range []string{"../secret", "..%2fsecret", "a.png", "/etc/passwd"} {
+		if _, e := MediaPath(p); e == nil {
+			t.Fatal(p)
+		}
+	}
+	r := New(1, 2)
+	r.HTTPStatus = 502
+	ParseResponse(&r, []byte(`{"error":{"message":"upstream unavailable"}}`), "application/json")
+	if r.State != "failed" || len(r.Images) != 0 {
+		t.Fatal(r)
+	}
+	ParseRequest(&r, []byte(`{"images":[{"image_url":"data:image/png;base64,invalid"}]}`), "application/json")
+	if r.References[0].State != "unavailable" {
+		t.Fatal("invalid image accepted")
+	}
+}
+func TestStreamFinalOnly(t *testing.T) {
+	t.Setenv("SUB2API_DRAWING_RECORD_DIR", t.TempDir())
+	r := New(1, 2)
+	r.HTTPStatus = 200
+	full, _ := json.Marshal(map[string]string{"type": "image_generation.completed", "b64_json": sample()})
+	partial, _ := json.Marshal(map[string]string{"type": "image_generation.partial_image", "b64_json": sample()})
+	body := "data: " + string(partial) + "\n\ndata: " + string(full) + "\n\ndata: [DONE]\n\n"
+	ParseResponse(&r, []byte(body), "text/event-stream")
+	if len(r.Images) != 1 || r.Images[0].State != "saved" {
+		t.Fatal(r)
+	}
+}
+func TestCaptureBudgetDoesNotTruncateTransport(t *testing.T) {
+	t.Setenv("SUB2API_DRAWING_RECORD_DIR", t.TempDir())
+	c, e := NewCapture()
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer c.Close()
+	c.Remaining = 3
+	n, e := c.Write([]byte("abcdef"))
+	if n != 6 || e != nil || !c.Truncated || string(c.Bytes()) != "abc" {
+		t.Fatal("capture must preserve caller write semantics")
+	}
+}
+func TestNoCredentialsInRequestRecord(t *testing.T) {
+	t.Setenv("SUB2API_DRAWING_RECORD_DIR", t.TempDir())
+	r := New(1, 2)
+	ParseRequest(&r, []byte(`{"prompt":"hello","access_token":"secret-token","authorization":"Bearer secret"}`), "application/json")
+	b, _ := json.Marshal(r)
+	if strings.Contains(string(b), "secret") {
+		t.Fatal("unexpected credential")
+	}
+}
+func TestDrawingRoundIsolationAndPartial(t *testing.T) {
+	a := New(1, 2)
+	a.RoundID = "same"
+	a.ConversationID = "chat"
+	a.RoundTotal = 2
+	a.State = "completed"
+	a.Images = []Media{{Name: "one", State: "saved"}}
+	b := New(1, 2)
+	b.RoundID = "same"
+	b.ConversationID = "chat"
+	b.State = "failed"
+	other := New(9, 2)
+	other.RoundID = "same"
+	other.ConversationID = "chat"
+	out := Group([]Record{a, b, other})
+	if len(out) != 2 || out[0].State != "partial" || out[0].Count != 2 || len(out[0].Requests) != 2 {
+		t.Fatal(out)
+	}
+	b.ConversationID = "another"
+	if len(Group([]Record{a, b})) != 2 {
+		t.Fatal("independent conversations merged")
+	}
+}
