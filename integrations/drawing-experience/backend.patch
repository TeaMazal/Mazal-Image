+package admin
+
+import (
+	"github.com/Wei-Shaw/sub2api/internal/pkg/drawingrecord"
+	"github.com/Wei-Shaw/sub2api/internal/pkg/pagination"
+	"github.com/Wei-Shaw/sub2api/internal/pkg/response"
+	"github.com/Wei-Shaw/sub2api/internal/pkg/usagestats"
+	"github.com/gin-gonic/gin"
+	"net/http"
+	"strconv"
+	"strings"
+)
+
+func (h *UsageHandler) DrawingRecords(c *gin.Context) {
+	if !drawingFullAdmin(c) {
+		return
+	}
+	rows, e := drawingrecord.List()
+	if e != nil {
+		response.Error(c, 500, "无法读取生成记录")
+		return
+	}
+	rows = drawingrecord.Group(rows)
+	search := strings.ToLower(strings.TrimSpace(c.Query("search")))
+	state := c.Query("state")
+	filtered := []drawingrecord.Record{}
+	for _, r := range rows {
+		if state != "" && state != r.State {
+			continue
+		}
+		if search != "" && !strings.Contains(strings.ToLower(r.Prompt+" "+r.Model+" "+strconv.FormatInt(r.UserID, 10)+" "+r.ID), search) {
+			continue
+		}
+		filtered = append(filtered, r)
+	}
+	page, _ := strconv.Atoi(c.Query("page"))
+	if page < 1 {
+		page = 1
+	}
+	size := 20
+	page = min(page, max(1, (len(filtered)+size-1)/size))
+	start := min((page-1)*size, len(filtered))
+	end := min(start+size, len(filtered))
+	items := []gin.H{}
+	for _, r := range filtered[start:end] {
+		items = append(items, h.drawingRecordView(c, r))
+	}
+	response.Success(c, gin.H{"items": items, "total": len(filtered), "page": page, "page_size": size})
+}
+func (h *UsageHandler) drawingRecordView(c *gin.Context, r drawingrecord.Record) gin.H {
+	for i, m := range r.Images {
+		if m.Name != "" && !drawingrecord.MediaExists(m) {
+			r.Images[i].State = "removed"
+			r.Images[i].Thumbnail = ""
+		}
+	}
+	result := gin.H{"record": r, "billing_status": "pending", "actual_cost": nil, "usage_ids": []int64{}}
+	cost := 0.0
+	ids := []int64{}
+	seen := map[int64]bool{}
+	matched := 0
+	requests := r.Requests
+	if len(requests) == 0 {
+		requests = []drawingrecord.RequestRef{{ID: r.ID, RequestID: r.RequestID, State: r.State}}
+	}
+	for _, req := range requests {
+		if req.RequestID == "" {
+			continue
+		}
+		logs, _, e := h.usageService.ListWithFilters(c.Request.Context(), pagination.PaginationParams{Page: 1, PageSize: 20}, usagestats.UsageLogFilters{APIKeyID: r.APIKeyID, RequestID: req.RequestID})
+		if e != nil {
+			continue
+		}
+		found := false
+		for _, u := range logs {
+			if u.RequestID != req.RequestID {
+				continue
+			}
+			found = true
+			if !seen[u.ID] {
+				seen[u.ID] = true
+				cost += u.ActualCost
+				ids = append(ids, u.ID)
+			}
+		}
+		if found {
+			matched++
+		}
+	}
+	if len(ids) > 0 {
+		result["actual_cost"] = cost
+		result["usage_ids"] = ids
+		result["billing_status"] = "partial"
+		if matched == len(requests) {
+			result["billing_status"] = "recorded"
+		}
+	}
+	return result
+}
+func (h *UsageHandler) DrawingRecordDetail(c *gin.Context) {
+	if !drawingFullAdmin(c) {
+		return
+	}
+	r, e := drawingrecord.Read(c.Param("id"))
+	if e != nil {
+		response.Error(c, 404, "生成记录不存在")
+		return
+	}
+	if r.RoundID != "" {
+		rows, e := drawingrecord.List()
+		if e != nil {
+			response.Error(c, 500, "无法读取同轮记录")
+			return
+		}
+		for _, group := range drawingrecord.Group(rows) {
+			if group.UserID == r.UserID && group.APIKeyID == r.APIKeyID && group.RoundID == r.RoundID && group.ConversationID == r.ConversationID {
+				r = group
+				break
+			}
+		}
+	}
+	response.Success(c, h.drawingRecordView(c, r))
+}
+func DrawingRecordMedia(c *gin.Context) {
+	if !drawingFullAdmin(c) {
+		return
+	}
+	p, e := drawingrecord.MediaPath(c.Param("name"))
+	if e != nil {
+		response.Error(c, 404, "图片不存在")
+		return
+	}
+	c.Header("Cache-Control", "private, no-store")
+	c.Header("X-Content-Type-Options", "nosniff")
+	if c.Query("download") == "1" {
+		c.FileAttachment(p, c.Param("name"))
+	} else {
+		c.File(p)
+	}
+	_ = http.StatusOK
+}
