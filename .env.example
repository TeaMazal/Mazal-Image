# Each site uses its own directory, Compose project, origins and storage.
COMPOSE_PROJECT_NAME=mazal-image
MI_BIND_ADDRESS=127.0.0.1
MI_PORT=8310
MI_SITE_NAME=Mazal Image
MI_PUBLIC_ORIGIN=https://image.example.com
MI_MAIN_ORIGIN=https://api.example.com
# Server-to-server gateway base; do not append /v1. No secrets here.
MI_GATEWAY_URL=https://api.example.com
MI_TRUSTED_PROXY_CIDR=172.16.0.0/12
MI_MEDIA_LIMIT_MB=1024
MI_MEDIA_MAX_AGE_HOURS=72
MI_MIN_FREE_MB=512
MI_BACKUP_KEEP=3
MI_BACKUP_LIMIT_MB=32
