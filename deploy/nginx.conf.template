server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    client_max_body_size 30m;
    set_real_ip_from ${MI_TRUSTED_PROXY_CIDR};
    real_ip_header X-Real-IP;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Content-Security-Policy "frame-ancestors 'self' ${MI_MAIN_ORIGIN}; object-src 'none'; base-uri 'self'" always;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Mazal-Engine-Only "";
    proxy_set_header Authorization $http_authorization;
    proxy_read_timeout 650s;
    proxy_send_timeout 650s;
    proxy_buffering off;

    location = /healthz { access_log off; default_type text/plain; return 200 "ok\n"; }
    location = / { add_header Cache-Control no-store; include /etc/nginx/snippets/security-headers.conf; try_files /index.html =404; }
    location = /embed { add_header Cache-Control no-store; include /etc/nginx/snippets/security-headers.conf; try_files /embed.html /index.html =404; }
    location = /index.html { add_header Cache-Control no-store; include /etc/nginx/snippets/security-headers.conf; try_files $uri =404; }
    location = /site-config.js { proxy_pass http://backend:8080; }
    location = /manifest.webmanifest { proxy_pass http://backend:8080; }
    location = /sw.js { add_header Cache-Control no-cache; include /etc/nginx/snippets/security-headers.conf; try_files $uri =404; }
    location ^~ /assets/ { try_files $uri =404; }
    location ^~ /template-media/ { proxy_buffering on; proxy_pass http://backend:8080; }
    location ^~ /licenses/ { try_files $uri $uri/index.html =404; }
    location ~ ^/(?:classic|workbench)(?:/|\.|$) { return 302 /; }
    location ^~ /engine/v1/ {
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Mazal-Engine-Only 1;
        proxy_pass http://backend:8080/v1/;
    }
    location ~ ^/(?:api|v1|v1beta|auth|images|image-thumbnails|files|image|accounts|settings|logs|debug|image-manager|templates|login|_next)(?:/|$) {
        add_header Content-Security-Policy "frame-ancestors 'none'; object-src 'none'" always;
        add_header Cache-Control no-store always;
        proxy_pass http://backend:8080;
    }
    location = /version { proxy_pass http://backend:8080; }
    location = /openai.svg { proxy_pass http://backend:8080; }
    location = /github.svg { proxy_pass http://backend:8080; }
    location = /health { proxy_pass http://backend:8080; }
    location ~ /(?:\.|config\.json|.*\.py$|.*\.db$) { return 404; }
    location / { try_files $uri =404; }
}
