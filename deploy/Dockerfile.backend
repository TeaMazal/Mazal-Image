FROM node:22-alpine AS admin-build
WORKDIR /src
COPY backend/engine/VERSION backend/engine/CHANGELOG.md ./
COPY backend/engine/web/package.json backend/engine/web/package-lock.json ./web/
WORKDIR /src/web
RUN npm ci --no-audit --no-fund
COPY backend/engine/web/ ./
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_OPTIONS=--max-old-space-size=2048
RUN npm run build

FROM python:3.13-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_LINK_MODE=copy
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends git libpq5 \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir uv==0.9.5
COPY backend/engine/pyproject.toml backend/engine/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY backend/engine/main.py backend/engine/VERSION ./
COPY backend/engine/api ./api
COPY backend/engine/services ./services
COPY backend/engine/utils ./utils
COPY backend/engine/scripts ./scripts
COPY backend/gateway_integration.py backend/site_config.py backend/maintenance.py backend/image_protocols.py backend/prompt_library.py ./
COPY backend/template_data ./template_data
COPY --from=admin-build /src/web/out ./web_dist
COPY LICENSE NOTICE.md ./licenses/
COPY licenses/ ./licenses/third-party/
COPY backend/engine/LICENSE ./licenses/engine-MIT.txt
RUN groupadd -g 10001 app && useradd -u 10001 -g app -M app
USER 10001:10001
EXPOSE 8080
CMD ["/app/.venv/bin/uvicorn", "gateway_integration:app", "--host", "0.0.0.0", "--port", "8080", "--proxy-headers", "--forwarded-allow-ips", "*"]
